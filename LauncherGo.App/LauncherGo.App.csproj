<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.6.8-pre.4</Version>
    <InformationalVersion>2.6.8-pre.4</InformationalVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <BaseOutputPath>bin\watch\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*" />
    <Content Include="..\docs\launchergo-introduction.html" Link="launchergo-introduction.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-LICENSES\**\*" Link="THIRD-PARTY-LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Semi.Avalonia" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LauncherGo.Abstractions\LauncherGo.Abstractions.csproj" />
    <ProjectReference Include="..\LauncherGo.Domains\LauncherGo.Domains.csproj" />
    <ProjectReference Include="..\LauncherGo.Services\LauncherGo.Services.csproj" />
    <ProjectReference Include="..\LauncherGo.ServerHost\LauncherGo.ServerHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LauncherGo.GatewayHost\LauncherGo.GatewayHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LauncherGo.ServerMapHost\LauncherGo.ServerMapHost.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LauncherGo.Ui\LauncherGo.Ui.csproj" />
  </ItemGroup>

  <Target Name="RemovePublishSymbolsFromOutput"
          AfterTargets="Publish"
          Condition="'$(StripPublishSymbols)' == 'true' and Exists('$(PublishDir)')">
    <ItemGroup>
      <_PublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>

    <Delete Files="@(_PublishSymbols)" />
  </Target>

  <Target Name="CopyServerHostBuildOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ServerHostBuildDir>$(MSBuildProjectDirectory)\..\LauncherGo.ServerHost\bin\$(Configuration)\net10.0\</_ServerHostBuildDir>
      <_ServerHostBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(_ServerHostBuildDir)$(RuntimeIdentifier)\</_ServerHostBuildDir>
    </PropertyGroup>
    <ItemGroup>
      <_ServerHostBuildFile Include="$(_ServerHostBuildDir)LauncherGo.ServerHost.exe" />
      <_ServerHostBuildFile Include="$(_ServerHostBuildDir)LauncherGo.ServerHost.dll" />
      <_ServerHostBuildFile Include="$(_ServerHostBuildDir)LauncherGo.ServerHost.deps.json" />
      <_ServerHostBuildFile Include="$(_ServerHostBuildDir)LauncherGo.ServerHost.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ServerHostBuildFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishServerHost"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_ServerHostProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LauncherGo.ServerHost\LauncherGo.ServerHost.csproj'))</_ServerHostProject>
      <_ServerHostPublishDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)serverhost-publish'))\</_ServerHostPublishDir>
    </PropertyGroup>

    <RemoveDir Directories="$(_ServerHostPublishDir)" />
    <MSBuild Projects="$(_ServerHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;DebugSymbols=false;PublishDir=$(_ServerHostPublishDir)" />
    <Copy SourceFiles="$(_ServerHostPublishDir)LauncherGo.ServerHost.exe"
          DestinationFiles="$(PublishDir)LauncherGo.ServerHost.exe" />
    <ItemGroup>
      <_ServerHostCompanion Include="$(PublishDir)LauncherGo.ServerHost.dll" />
      <_ServerHostCompanion Include="$(PublishDir)LauncherGo.ServerHost.deps.json" />
      <_ServerHostCompanion Include="$(PublishDir)LauncherGo.ServerHost.runtimeconfig.json" />
      <_ServerHostCompanion Include="$(PublishDir)LauncherGo.ServerHost.pdb" />
    </ItemGroup>
    <Delete Files="@(_ServerHostCompanion)" />
  </Target>

  <Target Name="CopyGatewayHostBuildOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GatewayHostBuildDir>$(MSBuildProjectDirectory)\..\LauncherGo.GatewayHost\bin\$(Configuration)\net10.0\</_GatewayHostBuildDir>
      <_GatewayHostBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(_GatewayHostBuildDir)$(RuntimeIdentifier)\</_GatewayHostBuildDir>
    </PropertyGroup>
    <ItemGroup>
      <_GatewayHostBuildFile Include="$(_GatewayHostBuildDir)LauncherGo.GatewayHost.exe" />
      <_GatewayHostBuildFile Include="$(_GatewayHostBuildDir)LauncherGo.GatewayHost.dll" />
      <_GatewayHostBuildFile Include="$(_GatewayHostBuildDir)LauncherGo.GatewayHost.deps.json" />
      <_GatewayHostBuildFile Include="$(_GatewayHostBuildDir)LauncherGo.GatewayHost.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_GatewayHostBuildFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyServerMapHostBuildOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup><_ServerMapHostBuildDir>$(MSBuildProjectDirectory)\..\LauncherGo.ServerMapHost\bin\$(Configuration)\net10.0\</_ServerMapHostBuildDir></PropertyGroup>
    <ItemGroup>
      <_ServerMapHostBuildFile Include="$(_ServerMapHostBuildDir)LauncherGo.ServerMapHost.exe" />
      <_ServerMapHostBuildFile Include="$(_ServerMapHostBuildDir)LauncherGo.ServerMapHost.dll" />
      <_ServerMapHostBuildFile Include="$(_ServerMapHostBuildDir)LauncherGo.ServerMapHost.deps.json" />
      <_ServerMapHostBuildFile Include="$(_ServerMapHostBuildDir)LauncherGo.ServerMapHost.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ServerMapHostBuildFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ServerMapHostBuildDir)WebRoot\index.html" DestinationFiles="$(TargetDir)WebRoot\index.html" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(TargetDir)EmbeddedMods\servermap" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\LauncherGo.Services\bin\$(Configuration)\net10.0\EmbeddedMods\servermap\servermap.zip"
          DestinationFiles="$(TargetDir)EmbeddedMods\servermap\servermap.zip"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\..\LauncherGo.Services\bin\$(Configuration)\net10.0\EmbeddedMods\servermap\servermap.zip')" />
  </Target>

  <Target Name="BuildServerBridgeMod"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ServerBridgeProject>$(MSBuildProjectDirectory)\..\LauncherGo.Services\EmbeddedMods\LauncherGoServerBridgeMod\LauncherGoServerBridgeMod.csproj</_ServerBridgeProject>
    </PropertyGroup>
    <MSBuild Projects="$(_ServerBridgeProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(_ServerBridgeProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="CopyServerBridgeModBuildOutput"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ServerBridgeBuildDir>$(MSBuildProjectDirectory)\..\LauncherGo.Services\EmbeddedMods\LauncherGoServerBridgeMod\bin\$(Configuration)\net10.0\</_ServerBridgeBuildDir>
      <_ServerBridgeContentDir>$(MSBuildProjectDirectory)\..\LauncherGo.Services\EmbeddedMods\launchergoserverbridge\</_ServerBridgeContentDir>
      <_ServerBridgeOutputDir>$(TargetDir)EmbeddedMods\launchergoserverbridge\</_ServerBridgeOutputDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_ServerBridgeOutputDir)" />
    <MakeDir Directories="$(_ServerBridgeOutputDir)" />
    <Copy SourceFiles="$(_ServerBridgeBuildDir)serverbridge.dll"
          DestinationFiles="$(_ServerBridgeOutputDir)serverbridge.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ServerBridgeContentDir)modinfo.json;$(_ServerBridgeContentDir)README.txt"
          DestinationFolder="$(_ServerBridgeOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyServerBridgeModPublishOutput"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(PublishDir)')">
    <PropertyGroup>
      <_ServerBridgeBuildDir>$(MSBuildProjectDirectory)\..\LauncherGo.Services\EmbeddedMods\LauncherGoServerBridgeMod\bin\$(Configuration)\net10.0\</_ServerBridgeBuildDir>
      <_ServerBridgeContentDir>$(MSBuildProjectDirectory)\..\LauncherGo.Services\EmbeddedMods\launchergoserverbridge\</_ServerBridgeContentDir>
      <_ServerBridgePublishDir>$(PublishDir)EmbeddedMods\launchergoserverbridge\</_ServerBridgePublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_ServerBridgePublishDir)" />
    <MakeDir Directories="$(_ServerBridgePublishDir)" />
    <Copy SourceFiles="$(_ServerBridgeBuildDir)serverbridge.dll"
          DestinationFiles="$(_ServerBridgePublishDir)serverbridge.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_ServerBridgeContentDir)modinfo.json;$(_ServerBridgeContentDir)README.txt"
          DestinationFolder="$(_ServerBridgePublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishGatewayHost"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_GatewayHostProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LauncherGo.GatewayHost\LauncherGo.GatewayHost.csproj'))</_GatewayHostProject>
      <_GatewayHostPublishDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)gatewayhost-publish'))\</_GatewayHostPublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_GatewayHostPublishDir)" />
    <MSBuild Projects="$(_GatewayHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;DebugType=None;DebugSymbols=false;PublishDir=$(_GatewayHostPublishDir)" />
    <Copy SourceFiles="$(_GatewayHostPublishDir)LauncherGo.GatewayHost.exe"
          DestinationFiles="$(PublishDir)LauncherGo.GatewayHost.exe" />
    <ItemGroup>
      <_GatewayHostCompanion Include="$(PublishDir)LauncherGo.GatewayHost.dll" />
      <_GatewayHostCompanion Include="$(PublishDir)LauncherGo.GatewayHost.deps.json" />
      <_GatewayHostCompanion Include="$(PublishDir)LauncherGo.GatewayHost.runtimeconfig.json" />
      <_GatewayHostCompanion Include="$(PublishDir)LauncherGo.GatewayHost.pdb" />
    </ItemGroup>
    <Delete Files="@(_GatewayHostCompanion)" />
  </Target>
</Project>
