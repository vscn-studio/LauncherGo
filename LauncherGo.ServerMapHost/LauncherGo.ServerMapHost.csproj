<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LauncherGo.ServerMapHost</AssemblyName>
    <AppHostDotNetSearch Condition="'$(SelfContained)' != 'true'">Global</AppHostDotNetSearch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LauncherGo.Domains\LauncherGo.Domains.csproj" />
    <ProjectReference Include="..\LauncherGo.Services\LauncherGo.Services.csproj" />
    <Content Include="WebRoot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveRetiredWebAssets" AfterTargets="Build;Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(TargetDir)WebRoot\assets\icons\temporal-gear.png" Condition="'$(TargetDir)' != ''" />
    <Delete Files="$(PublishDir)WebRoot\assets\icons\temporal-gear.png" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
