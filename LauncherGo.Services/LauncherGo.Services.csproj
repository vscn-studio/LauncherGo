<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EmbeddedServerMapModProject>$(MSBuildThisFileDirectory)EmbeddedMods\ServerMapMod\ServerMapMod.csproj</EmbeddedServerMapModProject>
    <EmbeddedServerMapModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\ServerMapMod\bin\$(Configuration)\</EmbeddedServerMapModBuildOutput>
    <EmbeddedAuthModProject>$(MSBuildThisFileDirectory)EmbeddedMods\VsslAuthMod\VsslAuthMod.csproj</EmbeddedAuthModProject>
    <EmbeddedAuthModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\VsslAuthMod\bin\$(Configuration)\net10.0\</EmbeddedAuthModBuildOutput>
    <EmbeddedAuthRoot>$(MSBuildThisFileDirectory)EmbeddedMods\launchergoauth\</EmbeddedAuthRoot>
    <EmbeddedRedirectModProject>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoRedirectMod\LauncherGoRedirectMod.csproj</EmbeddedRedirectModProject>
    <EmbeddedRedirectModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoRedirectMod\bin\$(Configuration)\net10.0\</EmbeddedRedirectModBuildOutput>
    <EmbeddedRedirectRoot>$(MSBuildThisFileDirectory)EmbeddedMods\launchergoredirect\</EmbeddedRedirectRoot>
    <EmbeddedServerBridgeModProject>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoServerBridgeMod\LauncherGoServerBridgeMod.csproj</EmbeddedServerBridgeModProject>
    <EmbeddedServerBridgeModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoServerBridgeMod\bin\$(Configuration)\net10.0\</EmbeddedServerBridgeModBuildOutput>
    <EmbeddedServerBridgeRoot>$(MSBuildThisFileDirectory)EmbeddedMods\launchergoserverbridge\</EmbeddedServerBridgeRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LauncherGo.Abstractions\LauncherGo.Abstractions.csproj" />
    <ProjectReference Include="..\LauncherGo.Domains\LauncherGo.Domains.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="EmbeddedMods\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.3.29-beta" />
    <PackageReference Include="NetMQ" Version="4.0.4.2" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <PackageReference Include="Discord.Net" Version="3.15.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="EmbeddedMods\launchergoauth\modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoauth\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoauth\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoauth\serverauth.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('EmbeddedMods\launchergoauth\serverauth.dll')" />
    <None Update="EmbeddedMods\launchergoredirect\modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoredirect\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoredirect\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoredirect\launchergoredirect.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('EmbeddedMods\launchergoredirect\launchergoredirect.dll')" />
    <None Update="EmbeddedMods\launchergoserverbridge\modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoserverbridge\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoserverbridge\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoserverbridge\serverbridge.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('EmbeddedMods\launchergoserverbridge\serverbridge.dll')" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="BuildEmbeddedAuthMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedAuthMod)' == 'true'">
    <MSBuild Projects="$(EmbeddedAuthModProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(EmbeddedAuthModProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="BuildEmbeddedServerMapMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedServerMapMod)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(EmbeddedServerMapModProject)" Targets="Restore;Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishDir"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
  </Target>

  <Target Name="CopyBuiltEmbeddedServerMapModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedServerMapMod)' == 'true' and Exists('$(EmbeddedServerMapModBuildOutput)servermap.zip')">
    <PropertyGroup><_EmbeddedServerMapOutputDir>$(TargetDir)EmbeddedMods\servermap\</_EmbeddedServerMapOutputDir></PropertyGroup>
    <MakeDir Directories="$(_EmbeddedServerMapOutputDir)" />
    <Copy SourceFiles="$(EmbeddedServerMapModBuildOutput)servermap.zip" DestinationFolder="$(_EmbeddedServerMapOutputDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildEmbeddedRedirectMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedRedirectMod)' == 'true'">
    <MSBuild Projects="$(EmbeddedRedirectModProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(EmbeddedRedirectModProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="BuildEmbeddedServerBridgeMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedServerBridgeMod)' == 'true'">
    <MSBuild Projects="$(EmbeddedServerBridgeModProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(EmbeddedServerBridgeModProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="CopyBuiltEmbeddedAuthModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedAuthMod)' == 'true' and Exists('$(EmbeddedAuthModBuildOutput)serverauth.dll')">
    <PropertyGroup>
      <_EmbeddedAuthOutputDir>$(TargetDir)EmbeddedMods\launchergoauth\</_EmbeddedAuthOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedAuthOutputDir)" />
    <Copy SourceFiles="$(EmbeddedAuthModBuildOutput)serverauth.dll"
          DestinationFiles="$(_EmbeddedAuthOutputDir)serverauth.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(EmbeddedAuthRoot)modinfo.json;$(EmbeddedAuthRoot)README.txt;$(EmbeddedAuthRoot)LICENSE.txt"
          DestinationFolder="$(_EmbeddedAuthOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltEmbeddedRedirectModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedRedirectMod)' == 'true' and Exists('$(EmbeddedRedirectModBuildOutput)launchergoredirect.dll')">
    <PropertyGroup>
      <_EmbeddedRedirectOutputDir>$(TargetDir)EmbeddedMods\launchergoredirect\</_EmbeddedRedirectOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedRedirectOutputDir)" />
    <Copy SourceFiles="$(EmbeddedRedirectModBuildOutput)launchergoredirect.dll"
          DestinationFiles="$(_EmbeddedRedirectOutputDir)launchergoredirect.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(EmbeddedRedirectRoot)modinfo.json;$(EmbeddedRedirectRoot)README.txt;$(EmbeddedRedirectRoot)LICENSE.txt"
          DestinationFolder="$(_EmbeddedRedirectOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBuiltEmbeddedServerBridgeModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedServerBridgeMod)' == 'true' and Exists('$(EmbeddedServerBridgeModBuildOutput)serverbridge.dll')">
    <PropertyGroup>
      <_EmbeddedServerBridgeOutputDir>$(TargetDir)EmbeddedMods\launchergoserverbridge\</_EmbeddedServerBridgeOutputDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_EmbeddedServerBridgeOutputDir)" />
    <MakeDir Directories="$(_EmbeddedServerBridgeOutputDir)" />
    <Copy SourceFiles="$(EmbeddedServerBridgeModBuildOutput)serverbridge.dll"
          DestinationFiles="$(_EmbeddedServerBridgeOutputDir)serverbridge.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(EmbeddedServerBridgeRoot)modinfo.json;$(EmbeddedServerBridgeRoot)README.txt;$(EmbeddedServerBridgeRoot)LICENSE.txt"
          DestinationFolder="$(_EmbeddedServerBridgeOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
