            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.SaveLockButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.SaveLockButton:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox TextBlock.ProfileSubText">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:selected TextBlock.ProfileSubText">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.DownloadTextButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.DownloadTextButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.DownloadTextButton:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.ToastSurface">
            <Setter Property="Background" Value="{DynamicResource ToastBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.ToastCloseButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid x:Name="WindowFrameContent" Background="Transparent" ClipToBounds="True">
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="8"
            Background="{DynamicResource WindowSurfaceBrush}">
            <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource WindowSurfaceBrush}">
                <Grid x:Name="ShellLayoutGrid" RowDefinitions="42,*" ClipToBounds="True">
                    <Border Grid.Row="0" Height="42" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="TitleHomeButton" Classes="TitleButton" Click="OnHomeNavClick" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Image Width="18" Height="18" Source="avares://LauncherGo.Ui/Assets/app-icon.ico" />
                                    <TextBlock Text="LauncherGo" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HeaderIconBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Font Awesome Free 7.2.0 icons; attribution and CC BY 4.0 text are in THIRD-PARTY-LICENSES. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="RepositoryButton" Classes="HeaderIconButton" Click="OnRepositoryClick" ToolTip.Tip="仓库">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M237.9 461.4C237.9 463.4 235.6 465 232.7 465C229.4 465.3 227.1 463.7 227.1 461.4C227.1 459.4 229.4 457.8 232.3 457.8C235.3 457.5 237.9 459.1 237.9 461.4zM206.8 456.9C206.1 458.9 208.1 461.2 211.1 461.8C213.7 462.8 216.7 461.8 217.3 459.8C217.9 457.8 216 455.5 213 454.6C210.4 453.9 207.5 454.9 206.8 456.9zM251 455.2C248.1 455.9 246.1 457.8 246.4 460.1C246.7 462.1 249.3 463.4 252.3 462.7C255.2 462 257.2 460.1 256.9 458.1C256.6 456.2 253.9 454.9 251 455.2zM316.8 72C178.1 72 72 177.3 72 316C72 426.9 141.8 521.8 241.5 555.2C254.3 557.5 258.8 549.6 258.8 543.1C258.8 536.9 258.5 502.7 258.5 481.7C258.5 481.7 188.5 496.7 173.8 451.9C173.8 451.9 162.4 422.8 146 415.3C146 415.3 123.1 399.6 147.6 399.9C147.6 399.9 172.5 401.9 186.2 425.7C208.1 464.3 244.8 453.2 259.1 446.6C261.4 430.6 267.9 419.5 275.1 412.9C219.2 406.7 162.8 398.6 162.8 302.4C162.8 274.9 170.4 261.1 186.4 243.5C183.8 237 175.3 210.2 189 175.6C209.9 169.1 258 202.6 258 202.6C278 197 299.5 194.1 320.8 194.1C342.1 194.1 363.6 197 383.6 202.6C383.6 202.6 431.7 169 452.6 175.6C466.3 210.3 457.8 237 455.2 243.5C471.2 261.2 481 275 481 302.4C481 398.9 422.1 406.6 366.2 412.9C375.4 420.8 383.2 435.8 383.2 459.3C383.2 493 382.9 534.7 382.9 542.9C382.9 549.4 387.5 557.3 400.2 555C500.2 521.8 568 426.9 568 316C568 177.3 455.5 72 316.8 72zM169.2 416.9C167.9 417.9 168.2 420.2 169.9 422.1C171.5 423.7 173.8 424.4 175.1 423.1C176.4 422.1 176.1 419.8 174.4 417.9C172.8 416.3 170.5 415.6 169.2 416.9zM158.4 408.8C157.7 410.1 158.7 411.7 160.7 412.7C162.3 413.7 164.3 413.4 165 412C165.7 410.7 164.7 409.1 162.7 408.1C160.7 407.5 159.1 407.8 158.4 408.8zM190.8 444.4C189.2 445.7 189.8 448.7 192.1 450.6C194.4 452.9 197.3 453.2 198.6 451.6C199.9 450.3 199.3 447.3 197.3 445.4C195.1 443.1 192.1 442.8 190.8 444.4zM179.4 429.7C177.8 430.7 177.8 433.3 179.4 435.6C181 437.9 183.7 438.9 185 437.9C186.6 436.6 186.6 434 185 431.7C183.6 429.4 181 428.4 179.4 429.7z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="FeedbackButton" Classes="HeaderIconButton" Click="OnFeedbackClick" ToolTip.Tip="反馈">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M176 168C189.3 168 200 157.3 200 144C200 130.7 189.3 120 176 120C162.7 120 152 130.7 152 144C152 157.3 162.7 168 176 168zM256 144C256 176.8 236.3 205 208 217.3L208 288L384 288C410.5 288 432 266.5 432 240L432 217.3C403.7 205 384 176.8 384 144C384 99.8 419.8 64 464 64C508.2 64 544 99.8 544 144C544 176.8 524.3 205 496 217.3L496 240C496 301.9 445.9 352 384 352L208 352L208 422.7C236.3 435 256 463.2 256 496C256 540.2 220.2 576 176 576C131.8 576 96 540.2 96 496C96 463.2 115.7 435 144 422.7L144 217.4C115.7 205 96 176.8 96 144C96 99.8 131.8 64 176 64C220.2 64 256 99.8 256 144zM488 144C488 130.7 477.3 120 464 120C450.7 120 440 130.7 440 144C440 157.3 450.7 168 464 168C477.3 168 488 157.3 488 144zM176 520C189.3 520 200 509.3 200 496C200 482.7 189.3 472 176 472C162.7 472 152 482.7 152 496C152 509.3 162.7 520 176 520z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="SponsorButton" Classes="HeaderIconButton" Click="OnSponsorClick" ToolTip.Tip="赞助">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M311.6 95C297.5 75.5 274.9 64 250.9 64C209.5 64 176 97.5 176 138.9L176 141.3C176 205.7 258 274.7 298.2 304.6C311.2 314.3 328.7 314.3 341.7 304.6C381.9 274.6 463.9 205.7 463.9 141.3L463.9 138.9C463.9 97.5 430.4 64 389 64C365 64 342.4 75.5 328.3 95L320 106.7L311.6 95zM141.3 405.5L98.7 448L64 448C46.3 448 32 462.3 32 480L32 544C32 561.7 46.3 576 64 576L384.5 576C413.5 576 441.8 566.7 465.2 549.5L591.8 456.2C609.6 443.1 613.4 418.1 600.3 400.3C587.2 382.5 562.2 378.7 544.4 391.8L424.6 480L312 480C298.7 480 288 469.3 288 456C288 442.7 298.7 432 312 432L384 432C401.7 432 416 417.7 416 400C416 382.3 401.7 368 384 368L231.8 368C197.9 368 165.3 381.5 141.3 405.5z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="MinimizeButton" Classes="HeaderIconButton" Click="OnMinimizeClick" ToolTip.Tip="最小化">
                                    <Viewbox Width="17" Height="17" UseLayoutRounding="True">
                                        <Path Classes="IconPath" Data="M96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="ToggleMaximizeButton" Classes="HeaderIconButton" Click="OnToggleMaximizeClick" ToolTip.Tip="最大化">
                                    <Viewbox Width="17" Height="17" UseLayoutRounding="True">
                                        <Grid Width="640" Height="640">
                                            <Path x:Name="MaximizeIconPath"
                                                  Classes="IconPath"
                                                  Data="M480 144C488.8 144 496 151.2 496 160L496 480C496 488.8 488.8 496 480 496L160 496C151.2 496 144 488.8 144 480L144 160C144 151.2 151.2 144 160 144L480 144zM160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96z" />
                                            <Path x:Name="RestoreIconCanvas"
                                                  Classes="IconPath"
                                                  Data="M192 96C139 96 96 139 96 192L96 416C96 469 139 512 192 512L224 512L224 464L192 464C165.5 464 144 442.5 144 416L144 192C144 165.5 165.5 144 192 144L416 144C442.5 144 464 165.5 464 192L464 224L512 224L512 192C512 139 469 96 416 96L192 96zM288 224C252.7 224 224 252.7 224 288L224 480C224 515.3 252.7 544 288 544L480 544C515.3 544 544 515.3 544 480L544 288C544 252.7 515.3 224 480 224L288 224zM288 272L480 272C497.7 272 512 286.3 512 304L512 480C512 497.7 497.7 512 480 512L288 512C270.3 512 256 497.7 256 480L256 304C256 286.3 270.3 272 288 272z"
                                                  IsVisible="False" />
                                        </Grid>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="CloseButton" Classes="HeaderIconButton" Click="OnCloseClick" ToolTip.Tip="关闭">
                                    <Viewbox Width="14" Height="14">
                                        <Path Classes="CloseIconPath" Data="M18 6L6 18M6 6L18 18" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="MainContentHost" Grid.Row="1" ColumnDefinitions="184,*" Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True">
                        <Border Grid.Column="0" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="{DynamicResource SplitLineBrush}" BorderThickness="0,0,1,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,10,14,14" Spacing="4">
                                    <TextBlock x:Name="ServerNavSectionTitleTextBlock" Classes="SidebarSectionTitle" Text="服务器" Margin="0,0,0,2" />
                                    <Button x:Name="MonitorNavButton" Classes="SidebarNavButton" Click="OnMonitorNavClick" />
                                    <Button x:Name="ConsoleNavButton" Classes="SidebarNavButton" Click="OnConsoleNavClick" />

                                    <TextBlock x:Name="ManageNavSectionTitleTextBlock" Classes="SidebarSectionTitle" Text="管理" />
                                    <Button x:Name="ProfilesTabButton" Classes="SidebarNavButton" Content="实例" Click="OnProfilesSubTabClick" />
                                    <Button x:Name="SavesTabButton" Classes="SidebarNavButton" Content="存档" Click="OnSavesSubTabClick" />
                                    <Button x:Name="ModsTabButton" Classes="SidebarNavButton" Content="模组" Click="OnModsSubTabClick" />
                                    <Button x:Name="AutomationTabButton" Classes="SidebarNavButton" Content="自动化" Click="OnAutomationSubTabClick" />
                                    <Button x:Name="ConnectionAuthTabButton" Classes="SidebarNavButton" Content="认证" Click="OnConnectionAuthTabClick" />
                                    <Button x:Name="ServerBridgeTabButton" Classes="SidebarNavButton" Content="服务器桥接" Click="OnServerBridgeSubTabClick" />
                                    <Button x:Name="ServerMapTabButton" Classes="SidebarNavButton" Content="服务器地图" Click="OnServerMapSubTabClick" />
                                    <Button x:Name="LogsNavButton" Classes="SidebarNavButton" Content="日志" Click="OnLogsNavClick" />
                                    <Button x:Name="DownloadVersionsNavButton" Classes="SidebarNavButton" Content="下载版本" Click="OnDownloadVersionsSubTabClick" />

                                    <TextBlock x:Name="ConnectionNavSectionTitleTextBlock" Classes="SidebarSectionTitle" Text="连接" />
                                    <Button x:Name="ConnectionRobotTabButton" Classes="SidebarNavButton" Content="OneBot" Click="OnConnectionRobotTabClick" />
                                    <Button x:Name="ConnectionDiscordTabButton" Classes="SidebarNavButton" Content="Discord" Click="OnConnectionDiscordTabClick" />
                                    <Button x:Name="ConnectionFrpTabButton" Classes="SidebarNavButton" Content="FRP" Click="OnConnectionFrpTabClick" />
                                    <Button x:Name="ConnectionEasyTierTabButton" Classes="SidebarNavButton" Content="EasyTier" Click="OnConnectionEasyTierTabClick" />
                                    <Button x:Name="ConnectionGatewayTabButton" Classes="SidebarNavButton" Content="网关" Click="OnConnectionGatewayTabClick" />

                                    <TextBlock x:Name="SettingsNavSectionTitleTextBlock" Classes="SidebarSectionTitle" Text="设置" />
                                    <Button x:Name="ServerSettingsTabButton" Classes="SidebarNavButton" Content="服务器设置" Click="OnServerSettingsTabClick" />
                                    <Button x:Name="AppearanceSettingsTabButton" Classes="SidebarNavButton" Content="外观" Click="OnAppearanceSettingsTabClick" />
                                    <Button x:Name="NetworkSettingsTabButton" Classes="SidebarNavButton" Content="网络" Click="OnNetworkSettingsTabClick" />
                                    <Button x:Name="AdvancedSettingsTabButton" Classes="SidebarNavButton" Content="高级" Click="OnAdvancedSettingsTabClick" />
                                    <Button x:Name="AboutSettingsTabButton" Classes="SidebarNavButton" Content="关于" Click="OnAboutSettingsTabClick" />
                                    <Button x:Name="SponsorsSettingsTabButton" Classes="SidebarNavButton" Content="赞助者" Click="OnSponsorsSettingsTabClick" />
                                    <Button x:Name="ContributorsSettingsTabButton" Classes="SidebarNavButton" Content="贡献者" Click="OnContributorsSettingsTabClick" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*,0" ClipToBounds="True">
                            <Grid x:Name="HomePanel" IsVisible="False">
                                <TextBlock x:Name="HomeSloganTextBlock" IsVisible="False" />
                            </Grid>

                            <Border
                            x:Name="NonHomePanelHost"
                            MinHeight="0"
                            Background="{DynamicResource WindowSurfaceBrush}"
                            ClipToBounds="True"
                            IsVisible="False"
                            RenderTransform="translate(0px,0px)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid Margin="18,10,18,10">
                                <Grid Margin="0">

                            <Grid x:Name="MonitorPanel" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="12" RowSpacing="12" MinHeight="0" IsVisible="False" ClipToBounds="True">
                                    <Border Classes="DashboardServerListPanel" Grid.Row="0" Grid.Column="0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="DashboardServersItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="DashboardServerCard">
                                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding ProfileName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                                                    <Border Grid.Column="2" Classes="DashboardStatusPill" Padding="8,3" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <Border Width="9" Height="9" CornerRadius="4.5" Background="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <Button
                                                                    Grid.Row="2"
                                                                    Classes="SecondaryActionButton"
                                                                    MinWidth="74"
                                                                    HorizontalAlignment="Right"
                                                                    Content="{Binding ActionText}"
                                                                    IsEnabled="{Binding IsActionEnabled}"
                                                                    Tag="{Binding}"
                                                                    Click="OnDashboardServerActionClick" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Classes="DashboardCard" Grid.Row="1" Grid.Column="0" MinHeight="0">
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" MinHeight="0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock x:Name="DashboardPlayersTitleText" Classes="DashboardTitle" Text="在线玩家" />
                                                <TextBlock x:Name="DashboardPlayersCountText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" Text="0/--" />
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.1*,64,72" ColumnSpacing="8">
                                                <TextBlock x:Name="DashboardPlayersHintText" Classes="DashboardLabel" Text="玩家名称" />
                                                <TextBlock x:Name="DashboardPlayersServerHeaderText" Grid.Column="1" Classes="DashboardLabel" Text="服务器" />
                                                <TextBlock x:Name="DashboardPlayersLatencyHeaderText" Grid.Column="2" Classes="DashboardLabel" Text="延迟" />
                                                <TextBlock x:Name="DashboardPlayersJoinedHeaderText" Grid.Column="3" Classes="DashboardLabel" Text="加入时间" />
                                            </Grid>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="DashboardOnlinePlayersItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="DashboardPlayerRow">
                                                                <Grid ColumnDefinitions="1.1*,1.1*,64,72" ColumnSpacing="8">
                                                                    <Button Classes="DashboardPlayerLink"
                                                                            Content="{Binding PlayerName}"
                                                                            IsEnabled="{Binding CanOpenDetails}"
                                                                            Tag="{Binding}"
                                                                            Click="OnDashboardPlayerClick" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProfileName}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding JoinedAtText}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border Classes="DashboardCard" Grid.Row="0" Grid.Column="1" MinHeight="0">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto" MinHeight="0">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="ChartTitleText" Grid.Row="0" Grid.Column="0" Classes="DashboardTitle" Text="资源监控" />
                                                <TextBlock x:Name="ChartTopValueText" Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Bottom" />
                                                <TextBlock x:Name="ChartSummaryText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" IsVisible="False" />
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,10,0,8" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="0">
                                                <Grid Grid.Row="0" Grid.Column="0" Width="50" RowDefinitions="*,*,*,*,*,*" VerticalAlignment="Stretch">
                                                    <TextBlock x:Name="YAxisLabelTop" Grid.Row="0" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <TextBlock x:Name="YAxisLabel2" Grid.Row="1" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="YAxisLabel3" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="YAxisLabel4" Grid.Row="3" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="YAxisLabel5" Grid.Row="4" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="YAxisLabelBottom" Grid.Row="5" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8">
                                                    <Viewbox Stretch="Fill">
                                                        <Canvas x:Name="ChartCanvas" Width="640" Height="248" Background="Transparent">
                                                            <Line StartPoint="0,0" EndPoint="640,0" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                            <Line StartPoint="0,50" EndPoint="640,50" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                            <Line StartPoint="0,100" EndPoint="640,100" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                            <Line StartPoint="0,150" EndPoint="640,150" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                            <Line StartPoint="0,200" EndPoint="640,200" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                            <Line StartPoint="0,248" EndPoint="640,248" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />

                                                            <Polyline x:Name="ChartLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="2.2" />
                                                            <Polyline x:Name="ChartLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="2.2" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <Grid Grid.Row="1" Grid.Column="1" Margin="4,6,0,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                                    <TextBlock x:Name="ChartXAxisText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Width="18" Height="3" Background="{DynamicResource PrimaryLineBrush}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="DashboardServerLineLegendText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Text="服务器" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Width="18" Height="3" Background="{DynamicResource SecondaryLineBrush}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="DashboardRobotLineLegendText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Text="QQ机器人" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <Grid x:Name="ChartDetailGrid" Grid.Row="2" Margin="0,0,0,4" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                                <StackPanel>
                                                    <TextBlock x:Name="DetailOneLabelText" Classes="DashboardLabel" />
                                                    <TextBlock x:Name="DetailOneValueText" Classes="DashboardValue" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="DetailTwoLabelText" Classes="DashboardLabel" />
                                                    <TextBlock x:Name="DetailTwoValueText" Classes="DashboardValue" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock x:Name="DetailThreeLabelText" Classes="DashboardLabel" />
                                                    <TextBlock x:Name="DetailThreeValueText" Classes="DashboardValue" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock x:Name="DetailFourLabelText" Classes="DashboardLabel" />
                                                    <TextBlock x:Name="DetailFourValueText" Classes="DashboardValue" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8" IsVisible="False" x:Name="EventTickerContainer">
                                                <Grid Height="24" ClipToBounds="True">
                                                    <TextBlock x:Name="EventTickerCurrentText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,0px)">
                                                        <TextBlock.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                            </Transitions>
                                                        </TextBlock.Transitions>
                                                    </TextBlock>
                                                    <TextBlock x:Name="EventTickerNextText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,24px)">
                                                        <TextBlock.Transitions>
                                                            <Transitions>
                                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                            </Transitions>
                                                        </TextBlock.Transitions>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Classes="DashboardCard" Grid.Row="1" Grid.Column="1">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                            <TextBlock x:Name="DashboardUptimeTitleText" Classes="DashboardTitle" Text="运行时间" />
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="DashboardUptimeItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="DashboardPlayerRow">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding UptimeText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                            </Grid>

                            <Grid x:Name="ConsolePanel" RowDefinitions="Auto,*,Auto" RowSpacing="8" MinHeight="0" IsVisible="False" Margin="-24,-6,-24,0" ClipToBounds="True">
                                <Grid Margin="24,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <ComboBox x:Name="ConsoleServerComboBox" Classes="CompactCombo" Width="220" SelectionChanged="OnConsoleServerSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Border Grid.Row="1" Classes="SectionPanel" Background="{DynamicResource ConsoleBackgroundBrush}" ClipToBounds="True">
                                    <ScrollViewer
                                        x:Name="ConsoleOutputScrollViewer"
                                        Margin="12,0,12,0"
                                        ClipToBounds="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        ScrollChanged="OnConsoleOutputScrollChanged">
                                        <SelectableTextBlock
                                            x:Name="ConsoleOutputTextBlock"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                                <Grid Grid.Row="2" Margin="24,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="CommandTextBox" Classes="CompactInput" PlaceholderText="输入服务器命令，回车发送" KeyDown="OnCommandTextBoxKeyDown" />
                                    <ComboBox
                                        x:Name="QuickCommandComboBox"
                                        Grid.Column="1"
                                        Classes="CompactCombo"
                                        PlaceholderText="快捷命令"
                                        SelectionChanged="OnQuickCommandSelectionChanged" />
                                    <Button x:Name="SendCommandButton" Grid.Column="2" Classes="ActionButton" Content="发送" Click="OnSendCommandClick" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="InstanceManagePanel" RowDefinitions="*" RowSpacing="10" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="False">
                                    <Button x:Name="ConfigTabButton" Classes="TextTabButton" Content="配置" Click="OnConfigSubTabClick" />
                                    <Button x:Name="DownloadVersionsTabButton" Classes="TextTabButton" Content="下载版本" Click="OnDownloadVersionsSubTabClick" />
                                </StackPanel>

                                <Grid Grid.Row="0">
                                    <Grid x:Name="ProfilesPanel" RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid ColumnDefinitions="Auto,180,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="CreateVersionComboBox" Grid.Column="0" Classes="CompactCombo" />
                                            <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="档案名称" />
                                            <Button x:Name="CreateProfileButton" Grid.Column="2" Classes="ActionButton" Content="创建" Click="OnCreateProfileClick" />
                                            <Button x:Name="ImportProfileButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportProfileClick" />
                                            <Button x:Name="DeleteProfileButton" Grid.Column="4" Classes="SecondaryActionButton DangerButton" Content="删除" Click="OnDeleteProfilesClick" />
                                            <Button x:Name="RefreshProfilesButton" Grid.Column="5" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshProfilesClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.05*,.7*,2.2*,1.8*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="档案" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="档案目录" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="当前存档" />
                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="ProfilesListBox" Classes="FlatList TableList" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.05*,.7*,2.2*,1.8*,Auto" ColumnSpacing="8">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding Version}" />
                                                                <Button Grid.Column="3" Classes="DownloadTextButton TablePathButton" Tag="{Binding DirectoryPath}" HorizontalAlignment="Stretch" Click="OnOpenProfileDirectoryClick">
                                                                    <TextBlock Classes="TableCellText ProfileSubText TablePathText" Text="{Binding DirectoryPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                </Button>
                                                                <TextBlock Grid.Column="4" Classes="TableCellText ProfileSubText" Text="{Binding ActiveSaveFile}" />
                                                                <Button Grid.Column="5" Classes="SecondaryActionButton" Tag="{Binding}" Content="修改" Click="OnEditProfileConfigClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="ConfigPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <Button x:Name="ConfigBackButton" Grid.Column="0" Classes="SecondaryActionButton" Content="返回" Click="OnConfigBackClick" />
                                            <ComboBox x:Name="ConfigProfileComboBox" IsVisible="False" SelectionChanged="OnConfigProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="ConfigRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConfigRefreshClick" />
                                            <Button x:Name="ConfigImportButton" Grid.Column="2" Classes="SecondaryActionButton" Content="导入" Click="OnConfigImportClick" />
                                            <Button x:Name="ConfigSaveButton" Grid.Column="3" Classes="ActionButton" Content="保存" Click="OnConfigSaveClick" />
                                        </Grid>

                                        <TextBlock x:Name="ConfigStatusTextBlock" Grid.Row="1" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />

                                        <Grid Grid.Row="2">
                                            <ScrollViewer x:Name="ConfigScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <StackPanel x:Name="ConfigContentHost" Spacing="10">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigBasicInfoTitleTextBlock" Classes="ConfigSectionTitle" Text="基础信息" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerNameLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器名称" />
                                                                    <TextBox x:Name="ConfigServerNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerLanguageLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器语言" />
                                                                    <ComboBox x:Name="ConfigServerLanguageComboBox" Classes="CompactCombo" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDefaultRoleCodeLabelTextBlock" Classes="ConfigFieldLabel" Text="默认角色代码" />
                                                                    <ComboBox x:Name="ConfigDefaultRoleComboBox" Classes="CompactCombo" SelectionChanged="OnConfigDefaultRoleSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBox x:Name="ConfigDefaultRoleCodeTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerDescriptionLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器描述" />
                                                                    <TextBox x:Name="ConfigServerDescriptionTextBox" Classes="MultiLineInput" Height="64" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigWelcomeMessageLabelTextBlock" Classes="ConfigFieldLabel" Text="进服提示" />
                                                                    <TextBox x:Name="ConfigWelcomeMessageTextBox" Classes="CompactInput" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigNetworkTitleTextBlock" Classes="ConfigSectionTitle" Text="网络与公开" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigIpLabelTextBlock" Classes="ConfigFieldLabel" Text="IP" />
                                                                    <TextBox x:Name="ConfigIpTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPortLabelTextBlock" Classes="ConfigFieldLabel" Text="端口" />
                                                                    <NumericUpDown x:Name="ConfigPortNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="65535" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsLabelTextBlock" Classes="ConfigFieldLabel" Text="最大玩家数" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsInQueueLabelTextBlock" Classes="ConfigFieldLabel" Text="排队人数上限" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsInQueueNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器网址" />
                                                                    <TextBox x:Name="ConfigServerUrlTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigAdvertiseServerToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="公开到服务器列表" />
                                                                    <ToggleSwitch x:Name="ConfigAdvertiseServerCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigUpnpToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="启用 UPnP 自动端口映射" />
                                                                    <ToggleSwitch x:Name="ConfigUpnpCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigSecurityTitleTextBlock" Classes="ConfigSectionTitle" Text="安全与维护" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPasswordLabelTextBlock" Classes="ConfigFieldLabel" Text="加入密码" />
                                                                    <TextBox x:Name="ConfigPasswordTextBox" Classes="CompactInput" PasswordChar="*" />
                                                                    <TextBlock x:Name="ConfigPasswordHintTextBlock" Classes="ConfigHintText" Text="留空表示不设置密码。" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWhitelistModeLabelTextBlock" Classes="ConfigFieldLabel" Text="白名单模式" />
                                                                    <ComboBox x:Name="ConfigWhitelistModeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWarnAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 警告秒数" />
                                                                    <NumericUpDown x:Name="ConfigWarnAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigKickAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 踢出秒数" />
                                                                    <NumericUpDown x:Name="ConfigKickAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigClientConnectionTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="连接超时秒数" />
                                                                    <NumericUpDown x:Name="ConfigClientConnectionTimeoutNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="3600" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxChunkRadiusLabelTextBlock" Classes="ConfigFieldLabel" Text="最大区块视距半径" />
                                                                    <NumericUpDown x:Name="ConfigMaxChunkRadiusNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="64" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDieBelowDiskSpaceMbLabelTextBlock" Classes="ConfigFieldLabel" Text="低于磁盘空间时关闭（MB）" />
                                                                    <NumericUpDown x:Name="ConfigDieBelowDiskSpaceMbNumericUpDown" Classes="CompactNumber" Minimum="-1" Maximum="1048576" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigVerifyPlayerAuthToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="启用官方账号验证" />
                                                                    <ToggleSwitch x:Name="ConfigVerifyPlayerAuthCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigAllowPvPToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="允许PvP" />
                                                                    <ToggleSwitch x:Name="ConfigAllowPvPCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigAllowFireSpreadToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="允许火势蔓延" />
                                                                    <ToggleSwitch x:Name="ConfigAllowFireSpreadCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigAllowFallingBlocksToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="允许方块掉落" />
                                                                    <ToggleSwitch x:Name="ConfigAllowFallingBlocksCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigPassTimeWhenEmptyToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="无人在线时继续流逝时间" />
                                                                    <ToggleSwitch x:Name="ConfigPassTimeWhenEmptyCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigCorruptionProtectionToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="启用存档损坏保护" />
                                                                    <ToggleSwitch x:Name="ConfigCorruptionProtectionCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ConfigRegenerateCorruptChunksToggleLabelTextBlock" Classes="ConfigFieldLabel" Text="重新生成损坏区块" />
                                                                    <ToggleSwitch x:Name="ConfigRegenerateCorruptChunksCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigStartupCommandsLabelTextBlock" Classes="ConfigFieldLabel" Text="启动后执行命令" />
                                                                    <TextBox x:Name="ConfigStartupCommandsTextBox" Classes="MultiLineInput" Height="74" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldTitleTextBlock" Classes="ConfigSectionTitle" Text="世界" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSeedLabelTextBlock" Classes="ConfigFieldLabel" Text="种子" />
                                                                    <TextBox x:Name="ConfigSeedTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldNameLabelTextBlock" Classes="ConfigFieldLabel" Text="世界名称" />
                                                                    <TextBox x:Name="ConfigWorldNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSaveFileLabelTextBlock" Classes="ConfigFieldLabel" Text="存档文件" />
                                                                    <ComboBox x:Name="ConfigSaveFileComboBox" Classes="CompactCombo" SelectionChanged="OnConfigSaveFileSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPlayStyleLabelTextBlock" Classes="ConfigFieldLabel" Text="游玩风格" />
                                                                    <ComboBox x:Name="ConfigPlayStyleComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldTypeLabelTextBlock" Classes="ConfigFieldLabel" Text="世界类型" />
                                                                    <ComboBox x:Name="ConfigWorldTypeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldHeightLabelTextBlock" Classes="ConfigFieldLabel" Text="世界高度" />
                                                                    <NumericUpDown x:Name="ConfigWorldHeightNumericUpDown" Classes="CompactNumber" Minimum="64" Maximum="2048" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <TextBlock x:Name="ConfigWorldGeneratedNoticeTextBlock" Classes="ConfigHintText" IsVisible="False" Text="当前存档已生成世界：建档阶段配置已锁定。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldRulesTitleTextBlock" Classes="ConfigSectionTitle" Text="世界规则" />
                                                            <ItemsControl x:Name="ConfigWorldRulesItemsControl">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10" IsEnabled="{Binding CanEdit}">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextWrapping="Wrap" />
                                                                                <ToggleSwitch Classes="ConfigCheck" IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                                                                                <ComboBox Classes="CompactCombo" IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceOptions}" SelectedItem="{Binding SelectedChoiceOption, Mode=TwoWay}">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <TextBox Classes="CompactInput" IsVisible="{Binding IsText}" Text="{Binding Value, Mode=TwoWay}" />
                                                                                <TextBlock Classes="ConfigHintText" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </ScrollViewer>

                                            <Border x:Name="ConfigEmptyPanel" Classes="ConfigCard" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="ConfigNoProfileTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" Text="暂无档案，请先创建档案。" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="SavesPanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,170,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="SaveProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnSaveProfileSelectionChanged" />
                                            <TextBox x:Name="NewSaveNameTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="新存档名称" />
                                            <Button x:Name="CreateSaveButton" Grid.Column="2" Classes="SecondaryActionButton" Content="创建存档" Click="OnCreateSaveClick" />
                                            <Button x:Name="ImportSaveButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportSaveClick" />
                                            <Button x:Name="DeleteSaveButton" Grid.Column="4" Classes="SecondaryActionButton DangerButton" Content="删除" Click="OnDeleteSavesClick" />
                                            <Button x:Name="RefreshSavesButton" Grid.Column="5" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshSavesClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.4*,1.1*,.8*,1.2*,2.2*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="存档" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="档案" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="大小" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="修改时间" />
                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="路径" />
                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="SavesListBox" Classes="FlatList TableList" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.4*,1.1*,.8*,1.2*,2.2*,Auto" ColumnSpacing="8" MinHeight="36">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding FileName}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding ProfileName}" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding SizeText}" />
                                                                <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding LastWriteText}" />
                                                                <Button Grid.Column="5" Classes="DownloadTextButton TablePathButton" Tag="{Binding DirectoryPath}" HorizontalAlignment="Stretch" Click="OnOpenSaveDirectoryClick">
                                                                    <TextBlock Classes="TableCellText TablePathText" Text="{Binding DirectoryPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                </Button>
                                                                <Button Grid.Column="6" Classes="SaveLockButton" Tag="{Binding}" Click="OnToggleDefaultSaveClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding LockIconBrush}" Data="{Binding LockIconData}" />
                                                                        <TextBlock Text="{Binding LockActionText}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="AutomationPanel" IsVisible="False">
                                        <Grid>
                                            <Grid x:Name="AutomationListPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                    <Button x:Name="AutomationClearButton" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnAutomationClearClick" />
                                                    <Button x:Name="AutomationListRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnAutomationRefreshClick" />
                                                </Grid>
                                                <TextBlock x:Name="AutomationStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" />
                                                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                                                    <Border Grid.Row="0" Classes="TableHeader">
                                                        <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="服务器名称" />
                                                            <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="配置路径" />
                                                            <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="修改时间" />
                                                            <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1" Classes="TableBody">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="AutomationConfigItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                                                <Button Grid.Column="2" Classes="DownloadTextButton TablePathButton" Tag="{Binding ConfigPath}" HorizontalAlignment="Stretch" Click="OnOpenConfigFileClick">
                                                                                    <TextBlock Classes="TableCellText TablePathText" Text="{Binding ConfigPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                                </Button>
                                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding ModifiedText}" />
                                                                                <Button Grid.Column="4" Classes="SecondaryActionButton" Tag="{Binding}" Content="修改" Click="OnAutomationEditConfigClick" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                            <Grid x:Name="AutomationEditorPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                    <ComboBox x:Name="AutomationProfileComboBox" IsVisible="False" Classes="CompactCombo" SelectionChanged="OnAutomationProfileSelectionChanged">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button x:Name="AutomationBackButton" Grid.Column="1" Classes="SecondaryActionButton" Content="返回" Click="OnAutomationBackClick" />
                                                    <Button x:Name="AutomationSaveButton" Grid.Column="2" Classes="ActionButton" Content="保存" Click="OnAutomationSaveClick" />
                                                    <Button x:Name="AutomationRefreshButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnAutomationRefreshClick" />
                                                </Grid>
                                                <TextBlock x:Name="AutomationEditorStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" />
                                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ClipToBounds="True">
                                            <StackPanel Spacing="10">
                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationRestartEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用定时开关服" />
                                                                <ToggleSwitch x:Name="AutomationRestartEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationBackupEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用定时备份" />
                                                                <ToggleSwitch x:Name="AutomationBackupEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationBackupBeforeShutdownLabelTextBlock" Classes="ConfigFieldLabel" Text="关服前备份" />
                                                                <ToggleSwitch x:Name="AutomationBackupBeforeShutdownCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationBroadcastEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用定时广播" />
                                                                <ToggleSwitch x:Name="AutomationBroadcastEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationCommandEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用定时命令" />
                                                                <ToggleSwitch x:Name="AutomationCommandEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationExportEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用日志导出" />
                                                                <ToggleSwitch x:Name="AutomationExportEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationExportBeforeShutdownLabelTextBlock" Classes="ConfigFieldLabel" Text="关服前导出日志" />
                                                                <ToggleSwitch x:Name="AutomationExportBeforeShutdownCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationExportIncludeChatLabelTextBlock" Classes="ConfigFieldLabel" Text="导出聊天" />
                                                                <ToggleSwitch x:Name="AutomationExportIncludeChatCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationExportIncludeServerLabelTextBlock" Classes="ConfigFieldLabel" Text="导出服务端信息" />
                                                                <ToggleSwitch x:Name="AutomationExportIncludeServerCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationClearCacheBeforeStartLabelTextBlock" Classes="ConfigFieldLabel" Text="开服前清理缓存" />
                                                                <ToggleSwitch x:Name="AutomationClearCacheBeforeStartCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ToggleField">
                                                                <TextBlock x:Name="AutomationScriptsEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用自动化脚本" />
                                                                <ToggleSwitch x:Name="AutomationScriptsEnabledCheckBox" Classes="LabelledToggle" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock x:Name="AutomationScriptsTitleTextBlock" Classes="ConfigSectionTitle" Text="自动化脚本" />
                                                            <Button x:Name="AutomationAddScriptButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddScriptClick" />
                                                        </Grid>
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="50,170,*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="模式" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="脚本路径" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationScriptsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="50,170,*,Auto" ColumnSpacing="8">
                                                                                    <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                    <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}" />
                                                                                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                                        <TextBox Classes="CompactInput" Text="{Binding ScriptPath, Mode=TwoWay}" ToolTip.Tip="{Binding ScriptPath}" />
                                                                                        <Button Grid.Column="1" Classes="SecondaryActionButton" Tag="{Binding}" Content="浏览" Click="OnAutomationBrowseScriptClick" />
                                                                                    </Grid>
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveScriptClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock x:Name="AutomationActionTitleTextBlock" Classes="ConfigSectionTitle" Text="定时开关服" />
                                                            <Button x:Name="AutomationAddActionButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddActionClick" />
                                                        </Grid>
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="50,110,112,112,70,70,92,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="模式" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="开始条件" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="结束条件" />
                                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="开始" />
                                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="结束" />
                                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="动作" />
                                                                    <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationActionsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="50,110,112,112,70,70,92,Auto" ColumnSpacing="8">
                                                                                    <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                    <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding ScheduleModeOptions}" SelectedItem="{Binding SelectedScheduleMode, Mode=TwoWay}" />
                                                                                    <Grid Grid.Column="2">
                                                                                        <ComboBox Classes="CompactCombo" ItemsSource="{Binding DayOfWeekOptions}" SelectedItem="{Binding SelectedStartDayOfWeek, Mode=TwoWay}" IsVisible="{Binding IsWeekly}" />
                                                                                        <CalendarDatePicker Classes="CompactDatePicker" PlaceholderText="yyyy-MM-dd" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" SelectedDate="{Binding StartDateValue, Mode=TwoWay}" IsVisible="{Binding IsDateRange}" />
                                                                                    </Grid>
                                                                                    <Grid Grid.Column="3">
                                                                                        <ComboBox Classes="CompactCombo" ItemsSource="{Binding DayOfWeekOptions}" SelectedItem="{Binding SelectedEndDayOfWeek, Mode=TwoWay}" IsVisible="{Binding IsWeekly}" />
                                                                                        <CalendarDatePicker Classes="CompactDatePicker" PlaceholderText="yyyy-MM-dd" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" SelectedDate="{Binding EndDateValue, Mode=TwoWay}" IsVisible="{Binding IsDateRange}" />
                                                                                    </Grid>
                                                                                    <TextBox Grid.Column="4" Classes="CompactInput" PlaceholderText="08:00" Text="{Binding StartTime, Mode=TwoWay}" />
                                                                                    <TextBox Grid.Column="5" Classes="CompactInput" PlaceholderText="23:00" Text="{Binding EndTime, Mode=TwoWay}" />
                                                                                    <ComboBox Grid.Column="6" Classes="CompactCombo" ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="7" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveActionClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <TextBlock Classes="ConfigSectionTitle" Text="定时备份" />
                                                                <Button x:Name="AutomationAddBackupScheduleButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddBackupScheduleClick" />
                                                            </Grid>
                                                            <Grid RowDefinitions="Auto,*">
                                                                <Border Grid.Row="0" Classes="TableHeader">
                                                                    <Grid ColumnDefinitions="46,165,*,165,Auto" ColumnSpacing="8">
                                                                        <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="周期" />
                                                                        <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="执行设置" />
                                                                        <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="预览" />
                                                                        <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Row="1" Classes="TableBody">
                                                                    <ItemsControl x:Name="AutomationBackupSchedulesItemsControl">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Classes="TableRow">
                                                                                    <Grid ColumnDefinitions="46,165,*,165,Auto" ColumnSpacing="8" MinHeight="38">
                                                                                        <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                        <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding ScheduleTypeOptions}" SelectedItem="{Binding SelectedScheduleType, Mode=TwoWay}" />
                                                                                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsMonthly}">
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding DayLabel}" VerticalAlignment="Center" />
                                                                                                <TextBox Width="54" Classes="CompactInput" PlaceholderText="1" Text="{Binding DayOfMonth, Mode=TwoWay}" />
                                                                                            </StackPanel>
                                                                                            <ComboBox Width="116" Margin="0,0,8,0" Classes="CompactCombo" ItemsSource="{Binding DayOfWeekOptions}" SelectedItem="{Binding SelectedDayOfWeek, Mode=TwoWay}" IsVisible="{Binding IsWeekly}" />
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsInterval}">
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding EveryLabel}" VerticalAlignment="Center" />
                                                                                                <TextBox Width="58" Classes="CompactInput" PlaceholderText="1" Text="{Binding Interval, Mode=TwoWay}" />
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding IntervalUnitLabel}" VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding ShowsTime}">
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding AtLabel}" VerticalAlignment="Center" />
                                                                                                <TextBox Width="76" Classes="CompactInput" PlaceholderText="03:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                            </StackPanel>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsHourly}">
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding MinuteLabel}" VerticalAlignment="Center" />
                                                                                                <TextBox Width="58" Classes="CompactInput" PlaceholderText="0" Text="{Binding MinuteOfHour, Mode=TwoWay}" />
                                                                                                <TextBlock Classes="ConfigHintText" Text="{Binding MinuteUnitLabel}" VerticalAlignment="Center" />
                                                                                            </StackPanel>
                                                                                        </WrapPanel>
                                                                                        <Button Grid.Column="3" Classes="SecondaryActionButton" Content="{Binding PreviewButtonText}" Tag="{Binding}" Click="OnAutomationPreviewBackupScheduleClick">
                                                                                            <Button.Flyout>
                                                                                                <Flyout Placement="Bottom">
                                                                                                    <Border Classes="ConfigCard" Padding="12" MinWidth="260">
                                                                                                        <StackPanel Spacing="8">
                                                                                                            <TextBlock Classes="ConfigSectionTitle" Text="{Binding PreviewTitle}" />
                                                                                                            <ItemsControl ItemsSource="{Binding PreviewExecutionItems}">
                                                                                                                <ItemsControl.ItemTemplate>
                                                                                                                    <DataTemplate>
                                                                                                                        <TextBlock Classes="ConfigHintText" Text="{Binding}" />
                                                                                                                    </DataTemplate>
                                                                                                                </ItemsControl.ItemTemplate>
                                                                                                            </ItemsControl>
                                                                                                        </StackPanel>
                                                                                                    </Border>
                                                                                                </Flyout>
                                                                                            </Button.Flyout>
                                                                                        </Button>
                                                                                        <Button Grid.Column="4" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveBackupScheduleClick" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,100,Auto,*" ColumnSpacing="8">
                                                                <TextBlock x:Name="AutomationBackupRetentionLabelTextBlock" Classes="ConfigFieldLabel" Text="保留备份数" VerticalAlignment="Center" />
                                                                <NumericUpDown x:Name="AutomationBackupRetentionNumericUpDown" Grid.Column="1" Classes="CompactNumber" Minimum="0" Maximum="100000" Increment="1" />
                                                                <TextBlock x:Name="AutomationBackupRetentionHintTextBlock" Grid.Column="2" Classes="ConfigHintText" Text="0 表示不限制" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Classes="ConfigCard">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <TextBlock Classes="ConfigSectionTitle" Text="日志导出" />
                                                                <Button x:Name="AutomationAddExportTimeButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddExportTimeClick" />
                                                            </Grid>
                                                            <Grid RowDefinitions="Auto,*">
                                                                <Border Grid.Row="0" Classes="TableHeader">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                        <TextBlock Classes="TableHeaderText" Text="时间" />
                                                                        <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Row="1" Classes="TableBody">
                                                                    <ItemsControl x:Name="AutomationExportTimesItemsControl">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Classes="TableRow">
                                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                        <TextBox Classes="CompactInput" PlaceholderText="12:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                        <Button Grid.Column="1" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveExportTimeClick" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock Classes="ConfigSectionTitle" Text="定时广播" />
                                                            <Button x:Name="AutomationAddBroadcastButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddBroadcastClick" />
                                                        </Grid>
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="时间" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="消息" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationBroadcastsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                                    <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                    <TextBox Grid.Column="1" Classes="CompactInput" PlaceholderText="12:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding Message, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveBroadcastClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock Classes="ConfigSectionTitle" Text="定时命令" />
                                                            <Button x:Name="AutomationAddCommandButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddCommandClick" />
                                                        </Grid>
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="时间" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="命令" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationCommandsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                                    <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                    <TextBox Grid.Column="1" Classes="CompactInput" PlaceholderText="12:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding Command, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveCommandClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="LogsPanel" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button x:Name="LogsRefreshButton" Classes="SecondaryActionButton" Content="刷新" Click="OnLogsRefreshClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="1.1*,2.4*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="档案" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="日志文件夹" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="LogsItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes="TableRow">
                                                                    <Grid ColumnDefinitions="1.1*,2.4*,Auto" ColumnSpacing="8" MinHeight="36">
                                                                        <TextBlock Classes="TableCellText" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="1" Classes="TableCellText TablePathText" Text="{Binding LogDirectoryPath}" ToolTip.Tip="{Binding LogDirectoryPath}" Foreground="{DynamicResource DownloadActionTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="2" Classes="SecondaryActionButton" Tag="{Binding}" Content="打开文件夹" Click="OnViewProfileLogClick" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="ModsPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="ModProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnModProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox x:Name="ModZipPathTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="Mod ZIP" />
                                            <Button x:Name="BrowseModZipButton" Grid.Column="2" Classes="SecondaryActionButton" Content="浏览" Click="OnBrowseModZipClick" />
                                            <Button x:Name="ImportModZipButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportModZipClick" />
                                            <Button x:Name="CheckModUpdatesButton" Grid.Column="4" Classes="SecondaryActionButton" Content="检查更新" Click="OnCheckModUpdatesClick" />
                                            <Button x:Name="ExportModsButton" Grid.Column="5" Classes="SecondaryActionButton" Content="导出" Click="OnExportModsClick" />
                                            <Button x:Name="DeleteSelectedModsButton" Grid.Column="6" Classes="SecondaryActionButton DangerButton" Content="删除" Click="OnDeleteSelectedModsClick" />
                                            <Button x:Name="RefreshModsButton" Grid.Column="7" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshModsClick" />
                                        </Grid>
                                        <TextBlock x:Name="ModStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" />
                                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.15*,1.1*,.7*,.7*,1.1*,1.1*,1.8*,2.2*,58,96,82" ColumnSpacing="8">
                                                    <CheckBox x:Name="ModSelectAllCheckBox" Classes="TableSelectCheck" IsThreeState="True" Click="OnModSelectAllClick" />
                                                    <TextBlock x:Name="ModNameHeaderTextBlock" Grid.Column="1" Classes="TableHeaderText" Text="名称" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="Mod ID" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock x:Name="ModSideHeaderTextBlock" Grid.Column="4" Classes="TableHeaderText" Text="端" />
                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="依赖" />
                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="问题" />
                                                    <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="配置路径" />
                                                    <TextBlock Grid.Column="8" Classes="TableHeaderText" Text="文件" />
                                                    <TextBlock Grid.Column="9" Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ModEditConfigHeaderTextBlock" Grid.Column="10" Classes="TableHeaderText" Text="编辑配置" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ModUpdateHeaderTextBlock" Grid.Column="11" Classes="TableHeaderText" Text="更新" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="ModsListBox" Classes="FlatList TableList" SelectionMode="Multiple" SelectionChanged="OnModsSelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.15*,1.1*,.7*,.7*,1.1*,1.1*,1.8*,2.2*,58,96,82" ColumnSpacing="8" MinHeight="36">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding Name}" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding ModId}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding Version}" />
                                                                <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding Side}" />
                                                                <TextBlock Grid.Column="5" Classes="TableCellText" Text="{Binding DependenciesText}" />
                                                                <TextBlock Grid.Column="6" Classes="TableCellText" Text="{Binding IssuesText}" />
                                                                <Button Grid.Column="7" Classes="DownloadTextButton TablePathButton" Tag="{Binding ConfigPath}" HorizontalAlignment="Stretch" Click="OnOpenModConfigPathClick">
                                                                    <TextBlock Classes="TableCellText TablePathText" Text="{Binding ConfigPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                </Button>
                                                                <TextBlock Grid.Column="8" Classes="TableCellText" Text="{Binding FilePath}" />
                                                                <ToggleSwitch Grid.Column="9" Classes="TableSwitch" IsChecked="{Binding ModEnabled, Mode=OneWay}" Tag="{Binding}" Click="OnModEnabledSwitchClick" />
                                                                <Button Grid.Column="10" Classes="SecondaryActionButton" Tag="{Binding}" Content="{Binding EditConfigText}" IsEnabled="{Binding CanEditConfig}" Click="OnEditModConfigClick" />
                                                                <Button Grid.Column="11" Classes="ModUpdateButton" Tag="{Binding}" Content="{Binding UpdateButtonText}" Foreground="{Binding UpdateStatusBrush}" IsVisible="{Binding IsUpdateButtonVisible}" Click="OnModUpdateClick" />
                                                                <TextBlock Grid.Column="11" Classes="TableCellText" Text="{Binding UpdateStatusText}" Foreground="{Binding UpdateStatusBrush}" HorizontalAlignment="Center" IsVisible="{Binding IsUpdateStatusVisible}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="DownloadVersionsPanel" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="DownloadVersionSearchTextBox" Grid.Column="0" Classes="CompactInput" PlaceholderText="搜索版本号" TextChanged="OnDownloadVersionSearchTextChanged" />
                                            <Button x:Name="ImportServerPackageButton" Grid.Column="1" Classes="SecondaryActionButton" Content="导入" Click="OnImportServerPackageClick" />
                                            <Button x:Name="RefreshDownloadVersionsButton" Grid.Column="2" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshDownloadVersionsClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="1.1*,1*,.8*,2.4*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="平台" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="大小" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="文件" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="DownloadVersionsListBox" Classes="FlatList TableList" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="1.1*,1*,.8*,2.4*,Auto" ColumnSpacing="8" MinHeight="36">
                                                                <TextBlock Classes="TableCellText" Text="{Binding DisplayText}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding Entry.Platform}" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding Entry.FileSize}" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding Entry.FileName}" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                    <Button Classes="DownloadTextButton" Tag="{Binding}" Content="{Binding ActionText}" IsVisible="{Binding CanDownload}" Click="OnDownloadVersionClick" />
                                                                    <TextBlock Classes="DownloadedTextLabel" Text="{Binding DownloadedText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DownloadedBadgeTextBrush}" IsVisible="{Binding IsDownloaded}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="DownloadStatusTextBlock" Grid.Row="2" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                    </Grid>

                                    <ScrollViewer x:Name="ServerBridgePanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <ComboBox x:Name="ServerBridgeProfileComboBox" IsVisible="False" Classes="CompactCombo" SelectionChanged="OnServerBridgeProfileSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="ServerBridgeClearButton" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnServerBridgeClearClick" />
                                                <Button x:Name="ServerBridgeBackButton" Grid.Column="1" Classes="SecondaryActionButton" Content="返回" Click="OnServerBridgeBackClick" IsVisible="False" />
                                                <Button x:Name="ServerBridgeSaveButton" Grid.Column="2" Classes="ActionButton" Content="保存" Click="OnServerBridgeSaveClick" IsVisible="False" />
                                                <Button x:Name="ServerBridgeRefreshButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnServerBridgeRefreshClick" />
                                                <Button x:Name="ServerBridgeDeployButton" Grid.Column="4" Classes="SecondaryActionButton" Content="部署服务器桥接模组" Click="OnServerBridgeDeployClick" IsVisible="False" />
                                                <Button x:Name="ServerBridgeTestButton" Grid.Column="5" Classes="SecondaryActionButton" Content="测试连接" Click="OnServerBridgeTestClick" IsVisible="False" />
                                                <Button x:Name="ServerBridgeRegenerateTokenButton" Grid.Column="6" Classes="SecondaryActionButton" Content="轮换令牌" Click="OnServerBridgeRegenerateTokenClick" IsVisible="False" />
                                            </Grid>
                                            <TextBlock x:Name="ServerBridgeStatusTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid x:Name="ServerBridgeListPanel" RowDefinitions="Auto,*">
                                                    <Border Grid.Row="0" Classes="TableHeader">
                                                        <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="服务器名称" />
                                                            <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="配置路径" />
                                                            <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="修改时间" />
                                                            <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1" Classes="TableBody">
                                                        <ItemsControl x:Name="ServerBridgeConfigItemsControl">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Classes="TableRow">
                                                                        <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                                            <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                            <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                                            <Button Grid.Column="2" Classes="DownloadTextButton TablePathButton" Tag="{Binding ConfigPath}" HorizontalAlignment="Stretch" Click="OnOpenConfigFileClick">
                                                                                <TextBlock Classes="TableCellText TablePathText" Text="{Binding ConfigPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                            </Button>
                                                                            <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding ModifiedText}" />
                                                                            <Button Grid.Column="4" Classes="SecondaryActionButton" Tag="{Binding}" Content="修改" Click="OnServerBridgeEditConfigClick" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                                <StackPanel x:Name="ServerBridgeEditorPanel" Spacing="10" IsVisible="False">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ServerBridgeEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用服务器桥接" />
                                                                    <ToggleSwitch x:Name="ServerBridgeEnabledCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ServerBridgePortLabelTextBlock" Classes="ConfigFieldLabel" Text="本机端口" />
                                                                    <NumericUpDown x:Name="ServerBridgePortNumericUpDown" Classes="CompactNumber" Minimum="1024" Maximum="65535" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ServerBridgeTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="查询超时毫秒" />
                                                                    <NumericUpDown x:Name="ServerBridgeTimeoutNumericUpDown" Classes="CompactNumber" Minimum="500" Maximum="30000" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ServerBridgeMaxLengthLabelTextBlock" Classes="ConfigFieldLabel" Text="最大命令长度" />
                                                                    <NumericUpDown x:Name="ServerBridgeMaxLengthNumericUpDown" Classes="CompactNumber" Minimum="256" Maximum="16384" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock x:Name="ServerBridgeFallbackLabelTextBlock" Classes="ConfigFieldLabel" Text="桥接不可用时回退 Relay" />
                                                                    <ToggleSwitch x:Name="ServerBridgeFallbackCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock Classes="ConfigFieldLabel" Text="扩展玩家信息" />
                                                                    <ToggleSwitch x:Name="ServerBridgeExtendedPlayersCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock Classes="ConfigFieldLabel" Text="世界详情" />
                                                                    <ToggleSwitch x:Name="ServerBridgeWorldDetailsCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock Classes="ConfigFieldLabel" Text="性能信息" />
                                                                    <ToggleSwitch x:Name="ServerBridgePerformanceCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ToggleField">
                                                                    <TextBlock Classes="ConfigFieldLabel" Text="敏感字段" />
                                                                    <ToggleSwitch x:Name="ServerBridgeSensitiveFieldsCheckBox" Classes="LabelledToggle" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <StackPanel Classes="ConfigFormFieldFull">
                                                                <TextBlock x:Name="ServerBridgeTokenLabelTextBlock" Classes="ConfigFieldLabel" Text="访问令牌" />
                                                                <TextBox x:Name="ServerBridgeTokenTextBox" Classes="CompactInput" PasswordChar="*" IsReadOnly="True" HorizontalAlignment="Stretch" />
                                                            </StackPanel>
                                                            <StackPanel Classes="ConfigFormFieldFull">
                                                                <TextBlock Classes="ConfigFieldLabel" Text="事件类型" />
                                                                <TextBox x:Name="ServerBridgeEventTypesTextBox" Classes="CompactInput" PlaceholderText="player.joined, player.left, player.died, chat, server.notification" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ServerMapPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <ComboBox x:Name="ServerMapProfileComboBox" IsVisible="False" Classes="CompactCombo" SelectionChanged="OnServerMapProfileSelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                                <Button x:Name="ServerMapClearButton" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnServerMapClearClick" />
                                                <Button x:Name="ServerMapBackButton" Grid.Column="1" Classes="SecondaryActionButton" Content="返回" Click="OnServerMapBackClick" IsVisible="False" />
                                                <Button x:Name="ServerMapSaveButton" Grid.Column="2" Classes="ActionButton" Content="保存" Click="OnServerMapSaveClick" IsVisible="False" />
                                                <Button x:Name="ServerMapRefreshButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnServerMapRefreshClick" />
                                                <Button x:Name="ServerMapDeployButton" Grid.Column="4" Classes="SecondaryActionButton" Content="部署服务器地图模组" Click="OnServerMapDeployClick" IsVisible="False" />
                                                <Button x:Name="ServerMapToggleButton" Grid.Column="5" Classes="SecondaryActionButton" Content="启动地图" Click="OnServerMapToggleClick" IsVisible="False" />
                                                <Button x:Name="ServerMapResetWebButton" Grid.Column="6" Classes="SecondaryActionButton" Content="重置网页" Click="OnServerMapResetWebClick" IsVisible="False" />
                                                <Button x:Name="ServerMapOpenButton" Grid.Column="7" Classes="SecondaryActionButton" Content="打开地图" Click="OnServerMapOpenClick" IsVisible="False" />
                                            </Grid>
                                            <TextBlock x:Name="ServerMapStatusTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid x:Name="ServerMapListPanel" RowDefinitions="Auto,*"><Border Grid.Row="0" Classes="TableHeader"><Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8"><TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" /><TextBlock Grid.Column="1" Classes="TableHeaderText" Text="服务器名称" /><TextBlock Grid.Column="2" Classes="TableHeaderText" Text="配置路径" /><TextBlock Grid.Column="3" Classes="TableHeaderText" Text="修改时间" /><TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" /></Grid></Border><Border Grid.Row="1" Classes="TableBody"><ItemsControl x:Name="ServerMapConfigItemsControl"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="TableRow"><Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8"><CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" /><TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding ProfileName}" FontWeight="SemiBold" /><Button Grid.Column="2" Classes="DownloadTextButton TablePathButton" Tag="{Binding ConfigPath}" HorizontalAlignment="Stretch" Click="OnOpenConfigFileClick"><TextBlock Classes="TableCellText TablePathText" Text="{Binding ConfigPath}" Foreground="{DynamicResource DownloadActionTextBrush}" /></Button><TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding ModifiedText}" /><Button Grid.Column="4" Classes="SecondaryActionButton" Tag="{Binding}" Content="修改" Click="OnServerMapEditConfigClick" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></Grid>
                                                <StackPanel x:Name="ServerMapEditorPanel" Spacing="10" IsVisible="False"><Border Classes="ConfigCard"><StackPanel Spacing="10"><WrapPanel Orientation="Horizontal"><StackPanel Classes="ToggleField"><TextBlock Classes="ConfigFieldLabel" Text="启用服务器地图" /><ToggleSwitch x:Name="ServerMapEnabledCheckBox" Classes="LabelledToggle" /></StackPanel><StackPanel Classes="ToggleField"><TextBlock Classes="ConfigFieldLabel" Text="启用 HTTPS" /><ToggleSwitch x:Name="ServerMapHttpsCheckBox" Classes="LabelledToggle" /></StackPanel><StackPanel Classes="ConfigFormField"><TextBlock Classes="ConfigFieldLabel" Text="监听端口" /><NumericUpDown x:Name="ServerMapListenPortNumericUpDown" Classes="CompactNumber" Minimum="1024" Maximum="65535" /></StackPanel></WrapPanel><TextBlock Classes="ConfigFieldLabel" Text="自定义 WebRoot" /><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Grid.Column="0" x:Name="ServerMapWebRootTextBox" PlaceholderText="默认内置网页" TextChanged="OnServerMapWebRootChanged" /><Button Grid.Column="1" x:Name="ServerMapWebRootBrowseButton" Classes="SecondaryActionButton" Content="浏览" Click="OnServerMapWebRootBrowseClick" /><Button Grid.Column="2" x:Name="ServerMapWebRootUpdateButton" Classes="SecondaryActionButton" Content="手动更新" Click="OnServerMapWebRootUpdateClick" IsEnabled="False" /></Grid><TextBlock Classes="ConfigFieldLabel" Text="证书路径" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Grid.Column="0" x:Name="ServerMapCertificateTextBox" PlaceholderText=".crt / .pem" /><Button Grid.Column="1" Classes="SecondaryActionButton" Content="浏览" Click="OnServerMapCertificateBrowseClick" /></Grid><TextBlock Classes="ConfigFieldLabel" Text="私钥路径" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Grid.Column="0" x:Name="ServerMapPrivateKeyTextBox" PlaceholderText=".key / .pem" /><Button Grid.Column="1" Classes="SecondaryActionButton" Content="浏览" Click="OnServerMapPrivateKeyBrowseClick" /></Grid></StackPanel></Border></StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="SettingsPanel" RowDefinitions="*" RowSpacing="10" IsVisible="False">
                                <Grid Grid.Row="0">
                                    <Grid x:Name="SettingsBlankPanel" />
                                    <ScrollViewer x:Name="SettingsServerPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsServerDirectoryTitleTextBlock" Classes="ConfigSectionTitle" Text="目录路径" />
                                                    <Grid RowDefinitions="Auto" ColumnDefinitions="86,*,Auto" RowSpacing="10" ColumnSpacing="10">
                                                        <TextBlock x:Name="SettingsWorkspaceDirectoryLabelTextBlock" Grid.Row="0" Classes="ConfigFieldLabel" VerticalAlignment="Center" Text="工作目录" />
                                                        <TextBox x:Name="SettingsWorkspaceDirectoryTextBox" Grid.Row="0" Grid.Column="1" Classes="CompactInput" />
                                                        <Button x:Name="SettingsBrowseWorkspaceDirectoryButton" Grid.Row="0" Grid.Column="2" Classes="SecondaryActionButton" Content="浏览" Click="OnSettingsBrowseWorkspaceDirectoryClick" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsSaveCompressionTitleTextBlock" Classes="ConfigSectionTitle" Text="存档压缩" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsSaveCompressionEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用存档压缩" />
                                                            <ToggleSwitch x:Name="SettingsSaveCompressionEnabledCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsSaveCompressionLevelLabelTextBlock" Classes="ConfigFieldLabel" Text="压缩等级" />
                                                            <NumericUpDown x:Name="SettingsSaveCompressionLevelNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="22" Increment="1" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="SettingsSaveCompressionPathLabelTextBlock" Classes="ConfigFieldLabel" Text="压缩路径" />
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                <TextBox x:Name="SettingsSaveCompressionPathTextBox" Classes="CompactInput" />
                                                                <Button x:Name="SettingsBrowseSaveCompressionPathButton" Grid.Column="1" Classes="SecondaryActionButton" Content="浏览" Click="OnSettingsBrowseSaveCompressionPathClick" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsSaveCompressionUpdateModeLabelTextBlock" Classes="ConfigFieldLabel" Text="更新方式" />
                                                            <ComboBox x:Name="SettingsSaveCompressionUpdateModeComboBox" Classes="CompactCombo" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsSaveCompressionDeleteSourceLabelTextBlock" Classes="ConfigFieldLabel" Text="压缩后删除原始文件" />
                                                            <ToggleSwitch x:Name="SettingsSaveCompressionDeleteSourceCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock x:Name="SettingsSaveCompressionHintTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <Button x:Name="SettingsCompressExistingBackupsButton" Grid.Column="1" Classes="SecondaryActionButton" Content="立即压缩已有备份" Click="OnSettingsCompressExistingBackupsClick" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsQuickCommandsTitleTextBlock" Classes="ConfigSectionTitle" Text="快捷命令" />
                                                    <TextBox x:Name="SettingsQuickCommandsTextBox" Classes="MultiLineInput" Height="92" AcceptsReturn="True" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsServerAutomationTitleTextBlock" Classes="ConfigSectionTitle" Text="启动与托盘" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsStartWithWindowsLabelTextBlock" Classes="ConfigFieldLabel" Text="开机启动启动器" />
                                                            <ToggleSwitch x:Name="SettingsStartWithWindowsCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsCloseToTrayLabelTextBlock" Classes="ConfigFieldLabel" Text="关闭时隐藏到托盘，不直接退出" />
                                                            <ToggleSwitch x:Name="SettingsCloseToTrayCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsStartHiddenLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时隐藏到托盘" />
                                                            <ToggleSwitch x:Name="SettingsStartHiddenCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartServerLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动启动服务器" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartServerCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoRestartServerAfterCrashLabelTextBlock" Classes="ConfigFieldLabel" Text="服务端异常退出后自动重启" />
                                                            <ToggleSwitch x:Name="SettingsAutoRestartServerAfterCrashCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartRobotLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动启动QQ机器人" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartRobotCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartDiscordLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动启动 Discord 机器人" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartDiscordCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartFrpLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动开启内网穿透（常规）" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartFrpCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartThirdPartyFrpcLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动开启第三方内网穿透" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartThirdPartyFrpcCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartEasyTierLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动开启 EasyTier" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartEasyTierCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="SettingsAutoStartGatewayLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动启动网关" />
                                                            <ToggleSwitch x:Name="SettingsAutoStartGatewayCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="SettingsAutoStartServerProfileLabelTextBlock" Classes="ConfigFieldLabel" Text="自启动服务器档案" />
                                                            <ComboBox x:Name="SettingsAutoStartServerProfileComboBox" Classes="CompactCombo" SelectionChanged="OnSettingsAutoStartServerProfileSelectionChanged" IsVisible="False">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <StackPanel Spacing="6">
                                                                <ItemsControl x:Name="SettingsAutoStartTargetsItemsControl">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ToggleButton Classes="TextTabButton" Content="{Binding DisplayName}" Tag="{Binding}" Click="OnSettingsAutoStartTargetChipClick" Margin="0,0,6,6" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Grid ColumnDefinitions="*,34,34" ColumnSpacing="6">
                                                                    <ComboBox x:Name="SettingsAutoStartAddProfileComboBox" Classes="CompactCombo" PlaceholderText="添加自启动服务器">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <Button x:Name="SettingsAutoStartAddProfileButton" Grid.Column="1" Classes="SecondaryActionButton" Content="+" Click="OnSettingsAutoStartAddProfileClick" />
                                                                    <Button x:Name="SettingsAutoStartRemoveProfileButton" Grid.Column="2" Classes="SecondaryActionButton DangerButton" Content="-" Click="OnSettingsAutoStartRemoveSelectedProfileClick" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                                                        <Button x:Name="SettingsServerSaveButton" Classes="ActionButton" Content="保存" Click="OnSettingsServerSaveClick" IsVisible="False" />
                                                        <Button x:Name="SettingsServerRefreshButton" Classes="SecondaryActionButton" Content="刷新" Click="OnSettingsServerRefreshClick" IsVisible="False" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SettingsServerStatusTextBlock" Classes="ConfigHintText" IsVisible="False" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,220,Auto" ColumnSpacing="10">
                                                        <TextBlock x:Name="SettingsConsoleLogFiltersTitleTextBlock" Classes="ConfigSectionTitle" Text="控制台日志过滤" />
                                                        <TextBox
                                                            x:Name="SettingsConsoleLogFiltersSearchTextBox"
                                                            Grid.Column="2"
                                                            Classes="CompactInput"
                                                            PlaceholderText="搜索过滤规则"
                                                            TextChanged="OnConsoleLogFiltersSearchTextChanged" />
                                                        <Button x:Name="SettingsAddConsoleLogFilterButton" Grid.Column="3" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnSettingsAddConsoleLogFilterClick" />
                                                    </Grid>
                                                    <TextBlock x:Name="SettingsConsoleLogFiltersHintTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" Text="默认过滤规则始终生效；启用下方规则后，匹配的日志不会显示在控制台。" />
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Classes="TableHeader">
                                                            <Grid ColumnDefinitions="54,150,*,Auto" ColumnSpacing="8">
                                                                <TextBlock x:Name="SettingsConsoleLogFiltersEnabledHeaderTextBlock" Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="SettingsConsoleLogFiltersModeHeaderTextBlock" Grid.Column="1" Classes="TableHeaderText" Text="匹配模式" />
                                                                <TextBlock x:Name="SettingsConsoleLogFiltersPatternHeaderTextBlock" Grid.Column="2" Classes="TableHeaderText" Text="匹配内容" />
                                                                <TextBlock x:Name="SettingsConsoleLogFiltersActionsHeaderTextBlock" Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Classes="TableBody">
                                                            <ItemsControl x:Name="SettingsConsoleLogFiltersItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="54,150,*,Auto" ColumnSpacing="8" MinHeight="38">
                                                                                <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                                                                                <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding Pattern, Mode=TwoWay}" LostFocus="OnConsoleLogFilterPatternLostFocus" />
                                                                                <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="{Binding DeleteLabel}" Click="OnSettingsRemoveConsoleLogFilterClick" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid x:Name="SettingsAppearancePanel" IsVisible="False" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsLanguageLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsLanguageComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsLanguageSelectionChanged" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsThemeLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsThemeComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsThemeSelectionChanged" />
                                        </Grid>
                                    </Grid>
                                    <ScrollViewer x:Name="SettingsNetworkPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsNetworkDownloadTitleTextBlock" Classes="ConfigSectionTitle" Text="下载网络" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="SettingsThirdPartyServerLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方服务端" />
                                                            <TextBox x:Name="SettingsThirdPartyServerTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsUpdateTitleTextBlock" Classes="ConfigSectionTitle" Text="LauncherGo 更新" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="SettingsGitHubProxyLabelTextBlock" Classes="ConfigFieldLabel" Text="GitHub 代理" />
                                                            <ComboBox x:Name="SettingsGitHubProxyComboBox" Classes="CompactCombo" SelectionChanged="OnGitHubProxySelectionChanged" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsAutoCheckUpdatesLabelTextBlock" Classes="ConfigFieldLabel" Text="启动时自动检查" />
                                                            <ToggleSwitch x:Name="SettingsAutoCheckUpdatesToggleSwitch" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button x:Name="SettingsCheckUpdatesButton" Classes="SecondaryActionButton" Content="检查更新（含预发布）" Click="OnSettingsCheckUpdatesClick" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="SettingsUpdateStatusTextBlock" Classes="ConfigHintText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsChunkedDownloadsTitleTextBlock" Classes="ConfigSectionTitle" Text="多线程分片" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsChunkedDownloadLabelTextBlock" Classes="ConfigFieldLabel" Text="启用" />
                                                            <ToggleSwitch x:Name="SettingsChunkedDownloadToggleSwitch" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsDownloadChunkCountLabelTextBlock" Classes="ConfigFieldLabel" Text="分片数量" />
                                                            <TextBox x:Name="SettingsDownloadChunkCountTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsDownloadThreadCountLabelTextBlock" Classes="ConfigFieldLabel" Text="下载线程数" />
                                                            <TextBox x:Name="SettingsDownloadThreadCountTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="SettingsAdvancedPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsAdvancedActionsTitleTextBlock" Classes="ConfigSectionTitle" Text="维护" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button x:Name="SettingsOpenLogButton" Classes="SecondaryActionButton" Content="打开软件日志" Click="OnSettingsOpenLogClick" Margin="0,0,8,8" />
                                                        <Button x:Name="SettingsClearDownloadCacheButton" Classes="SecondaryActionButton DangerButton" Content="清空下载缓存" Click="OnSettingsClearDownloadCacheClick" Margin="0,0,8,8" />
                                                        <Button x:Name="SettingsResetAllButton" Classes="SecondaryActionButton DangerButton" Content="重置所有设置" Click="OnSettingsResetAllClick" Margin="0,0,8,8" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="SettingsAdvancedStatusTextBlock" Classes="ConfigHintText" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border x:Name="SettingsAboutPanel" Classes="ConfigCard" IsVisible="False">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="14">
                                            <Border BorderBrush="{DynamicResource SplitLineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="52,*" ColumnSpacing="12">
                                                        <Image Width="44" Height="44" Source="avares://LauncherGo.Ui/Assets/app-icon.ico" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="LauncherGo" Classes="AboutHeading1" Margin="0" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="AboutVersionTextBlock" Classes="AboutParagraph" FontWeight="SemiBold" Margin="0,0,12,0" />
                                                                <TextBlock x:Name="AboutPackageKindTextBlock" Classes="AboutSubText" />
                                                            </WrapPanel>
                                                            <TextBlock x:Name="AboutCopyrightTextBlock" Classes="AboutSubText" />
                                                            <TextBlock x:Name="AboutLicenseTextBlock" Classes="AboutSubText" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button x:Name="AboutRepositoryButton" Classes="SecondaryActionButton" Content="源码仓库" Click="OnRepositoryClick" Margin="0,0,8,8" />
                                                        <Button x:Name="AboutLicenseButton" Classes="SecondaryActionButton" Content="MIT 许可证" Tag="LICENSE" Click="OnAboutDocumentClick" Margin="0,0,8,8" />
                                                        <Button x:Name="AboutNoticeButton" Classes="SecondaryActionButton" Content="版权声明" Tag="NOTICE" Click="OnAboutDocumentClick" Margin="0,0,8,8" />
                                                        <Button x:Name="AboutThirdPartyButton" Classes="SecondaryActionButton" Content="第三方声明" Tag="THIRD-PARTY-NOTICES.md" Click="OnAboutDocumentClick" Margin="0,0,8,8" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="AboutActionStatusTextBlock" Classes="ConfigHintText" IsVisible="False" />
                                                </StackPanel>
                                            </Border>
                                            <ContentControl x:Name="SettingsAboutContentHost" Grid.Row="1" />
                                        </Grid>
                                    </Border>
                                    <ScrollViewer x:Name="SettingsSponsorsPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <ItemsControl x:Name="SettingsSponsorsItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10">
                                                            <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                                                <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardHoverBrush}">
                                                                    <Grid>
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoAvatar}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding AmountText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding PlanText}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="SettingsContributorsPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <ItemsControl x:Name="SettingsContributorsItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10">
                                                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                                                <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardHoverBrush}">
                                                                    <Grid>
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoAvatar}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock Text="{Binding Login}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ContributionsText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Classes="DownloadTextButton" Content="打开" Tag="{Binding HtmlUrl}" Click="OnContributorOpenClick" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ConnectionPanel" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
                                <TextBlock x:Name="ConnectionStatusTextBlock" Grid.Row="0" Classes="ConfigHintText" IsVisible="False" />
                                <Grid Grid.Row="1">
                                    <ScrollViewer x:Name="ConnectionFrpPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="ConnectionFrpSaveButton" Classes="ActionButton" Content="保存" Click="OnConnectionFrpSaveClick" IsVisible="False" />
                                                <Button x:Name="ConnectionFrpRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConnectionRefreshClick" IsVisible="False" />
                                                <Button x:Name="ConnectionFrpImportButton" Classes="SecondaryActionButton" Content="导入frpc" Click="OnConnectionFrpImportClick" />
                                                <Button x:Name="ConnectionFrpToggleButton" Grid.Column="1" Classes="SecondaryActionButton" Content="启动常规" Click="OnConnectionFrpToggleClick" />
                                                <Button x:Name="ConnectionFrpEditTomlButton" Grid.Column="2" Classes="SecondaryActionButton" Content="编辑常规TOML" Click="OnConnectionFrpEditTomlClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcImportButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入第三方frpc" Click="OnConnectionThirdPartyFrpcImportClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcToggleButton" Grid.Column="4" Classes="SecondaryActionButton" Content="启动第三方" Click="OnConnectionThirdPartyFrpcToggleClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcEditTomlButton" Grid.Column="5" Classes="SecondaryActionButton" Content="编辑第三方TOML" Click="OnConnectionThirdPartyFrpcEditTomlClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="ConnectionFrpTitleTextBlock" Classes="ConfigSectionTitle" Text="内网穿透配置" IsVisible="False" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="ConnectionFrpCommandLabelTextBlock" Classes="ConfigFieldLabel" Text="常规启动命令" />
                                                            <TextBox x:Name="ConnectionFrpCommandTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="ConnectionThirdPartyFrpcModeLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方模式" />
                                                            <ComboBox x:Name="ConnectionThirdPartyFrpcModeComboBox" Classes="CompactCombo" SelectionChanged="OnConnectionThirdPartyFrpcModeSelectionChanged">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="ConnectionThirdPartyFrpcCommandLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方启动命令" />
                                                            <TextBox x:Name="ConnectionThirdPartyFrpcCommandTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionEasyTierPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="EasyTierSaveButton" Classes="ActionButton" Content="保存" Click="OnEasyTierSaveClick" />
                                                <Button x:Name="EasyTierRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnEasyTierRefreshClick" />
                                                <Button x:Name="EasyTierImportCoreButton" Grid.Column="2" Classes="SecondaryActionButton" Content="导入 Core" Click="OnEasyTierImportCoreClick" />
                                                <Button x:Name="EasyTierImportCliButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入 CLI" Click="OnEasyTierImportCliClick" />
                                                <Button x:Name="EasyTierToggleButton" Grid.Column="4" Classes="SecondaryActionButton" Content="启动" Click="OnEasyTierToggleClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="EasyTierRoomPrefixLabelTextBlock" Classes="ConfigFieldLabel" Text="房间前缀" />
                                                            <TextBox x:Name="EasyTierRoomPrefixTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="EasyTierGamePortLabelTextBlock" Classes="ConfigFieldLabel" Text="游戏端口" />
                                                            <NumericUpDown x:Name="EasyTierGamePortNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="65535" Increment="1" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="EasyTierPeerNodesLabelTextBlock" Classes="ConfigFieldLabel" Text="引导/中继节点" />
                                                            <TextBox x:Name="EasyTierPeerNodesTextBox" Classes="CompactInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="EasyTierNetworkNameLabelTextBlock" Classes="ConfigFieldLabel" Text="自定义网络名称" />
                                                            <TextBox x:Name="EasyTierNetworkNameTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="EasyTierNetworkSecretLabelTextBlock" Classes="ConfigFieldLabel" Text="自定义网络密钥" />
                                                            <TextBox x:Name="EasyTierNetworkSecretTextBox" Classes="CompactInput" PasswordChar="*" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="EasyTierUdpLabelTextBlock" Classes="ConfigFieldLabel" Text="UDP 游戏端口" />
                                                            <ToggleSwitch x:Name="EasyTierUdpCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="EasyTierLatencyFirstLabelTextBlock" Classes="ConfigFieldLabel" Text="低延迟优先" />
                                                            <ToggleSwitch x:Name="EasyTierLatencyFirstCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="EasyTierCompressionLabelTextBlock" Classes="ConfigFieldLabel" Text="Zstd 压缩" />
                                                            <ToggleSwitch x:Name="EasyTierCompressionCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="EasyTierKcpLabelTextBlock" Classes="ConfigFieldLabel" Text="KCP 代理" />
                                                            <ToggleSwitch x:Name="EasyTierKcpCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="EasyTierRoomCodeLabelTextBlock" Classes="ConfigFieldLabel" Text="MVL 分享码" />
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBox x:Name="EasyTierRoomCodeTextBox" Classes="CompactInput" IsReadOnly="True" />
                                                                <Button x:Name="EasyTierCopyRoomCodeButton" Grid.Column="1" Classes="SecondaryActionButton" Content="复制" Click="OnEasyTierCopyRoomCodeClick" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="EasyTierGameAddressLabelTextBlock" Classes="ConfigFieldLabel" Text="ET 游戏地址" />
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBox x:Name="EasyTierGameAddressTextBox" Classes="CompactInput" IsReadOnly="True" />
                                                                <Button x:Name="EasyTierCopyGameAddressButton" Grid.Column="1" Classes="SecondaryActionButton" Content="复制" Click="OnEasyTierCopyGameAddressClick" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <TextBlock x:Name="EasyTierRuntimeInfoTextBlock" Classes="ConfigHintText" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionRobotPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="RobotSaveButton" Classes="ActionButton" Content="保存" Click="OnRobotSaveClick" />
                                                <Button x:Name="RobotToggleButton" Grid.Column="1" Classes="SecondaryActionButton" Content="启动" Click="OnRobotToggleClick" />
                                                <Button x:Name="RobotClearButton" Grid.Column="2" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnRobotClearClick" />
                                                <Button x:Name="RobotRefreshButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnRobotRefreshClick" />
                                            </Grid>
                                            <Border x:Name="RobotEditorPanel" Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="RobotConfigTitleTextBlock" Classes="ConfigSectionTitle" Text="QQ机器人配置" IsVisible="False" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="RobotOneBotLabelTextBlock" Classes="ConfigFieldLabel" Text="OneBot WebSocket" />
                                                            <TextBox x:Name="RobotOneBotTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotAccessTokenLabelTextBlock" Classes="ConfigFieldLabel" Text="访问令牌" />
                                                            <TextBox x:Name="RobotAccessTokenTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotReconnectLabelTextBlock" Classes="ConfigFieldLabel" Text="重连间隔秒数" />
                                                            <NumericUpDown x:Name="RobotReconnectNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="120" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="RobotDatabasePathLabelTextBlock" Classes="ConfigFieldLabel" Text="数据库路径" />
                                                            <TextBox x:Name="RobotDatabasePathTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotDefaultEncodingLabelTextBlock" Classes="ConfigFieldLabel" Text="默认编码" />
                                                            <TextBox x:Name="RobotDefaultEncodingTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotFallbackEncodingLabelTextBlock" Classes="ConfigFieldLabel" Text="回退编码" />
                                                            <TextBox x:Name="RobotFallbackEncodingTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <TextBlock x:Name="RobotBridgeSourceHintTextBlock" Classes="ConfigHintText" Text="机器人通过服务器桥接按需查询并订阅事件。" IsVisible="False" />
                                                    <TextBox x:Name="RobotBoundGroupsTextBox" IsVisible="False" />
                                                    <TextBox x:Name="RobotSuperUsersTextBox" IsVisible="False" />
                                                    <StackPanel Spacing="8">
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="2*,1.3*,1.3*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="服务器档案" />
                                                                    <TextBlock Grid.Column="1" x:Name="RobotBoundGroupsLabelTextBlock" Classes="TableHeaderText" Text="绑定群号" />
                                                                    <TextBlock Grid.Column="2" x:Name="RobotSuperUsersLabelTextBlock" Classes="TableHeaderText" Text="超级管理员 QQ" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="RobotBindingsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="2*,1.3*,1.3*,Auto" ColumnSpacing="8">
                                                                                    <ComboBox Classes="CompactCombo" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                                        <ComboBox.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                            </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                    <TextBox Grid.Column="1" Classes="CompactInput" Text="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding SuperUserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnRobotBindingRemoveClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                        <Button x:Name="RobotBindingAddButton" Classes="SecondaryActionButton" Width="120" HorizontalAlignment="Left" Content="添加" Click="OnRobotBindingAddClick" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                                        <TextBlock x:Name="RobotTeleportPointsTitleTextBlock" Classes="ConfigSectionTitle" Text="传送设置点" />
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="2*,1*,1*,1*,68" ColumnSpacing="10">
                                                                    <TextBlock x:Name="RobotTeleportPointNameHeaderTextBlock" Classes="TableHeaderText" Text="设置点名称" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="X" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="Y" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="Z" />
                                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="RobotTeleportPointsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="2*,1*,1*,1*,68" ColumnSpacing="10">
                                                                                    <TextBox Classes="CompactInput" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <NumericUpDown Grid.Column="1" Classes="CompactNumber" Minimum="-1000000000" Maximum="1000000000" Increment="1" Value="{Binding X, Mode=TwoWay}" />
                                                                                    <NumericUpDown Grid.Column="2" Classes="CompactNumber" Minimum="-1000000000" Maximum="1000000000" Increment="1" Value="{Binding Y, Mode=TwoWay}" />
                                                                                    <NumericUpDown Grid.Column="3" Classes="CompactNumber" Minimum="-1000000000" Maximum="1000000000" Increment="1" Value="{Binding Z, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="4" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnRobotTeleportPointRemoveClick" Width="68" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                        <Button x:Name="RobotTeleportPointAddButton" Classes="SecondaryActionButton" Width="120" HorizontalAlignment="Left" Content="添加" Click="OnRobotTeleportPointAddClick" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                                        <TextBlock x:Name="RobotCustomCommandsTitleTextBlock" Classes="ConfigSectionTitle" Text="自定义指令" />
                                                        <TextBlock x:Name="RobotCustomCommandHintTextBlock" Classes="ConfigHintText" Text="指令以 / 开头；内置指令前缀不可用。" TextWrapping="Wrap" />
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="150,140,*,68" ColumnSpacing="10">
                                                                    <TextBlock x:Name="RobotCustomCommandNameHeaderTextBlock" Classes="TableHeaderText" Text="指令" />
                                                                    <TextBlock x:Name="RobotCustomCommandTypeHeaderTextBlock" Grid.Column="1" Classes="TableHeaderText" Text="类型" />
                                                                    <TextBlock x:Name="RobotCustomCommandContentHeaderTextBlock" Grid.Column="2" Classes="TableHeaderText" Text="内容" />
                                                                    <TextBlock x:Name="RobotCustomCommandActionHeaderTextBlock" Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="RobotCustomCommandsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow" Padding="10,8">
                                                                                <Grid ColumnDefinitions="150,140,*,68" ColumnSpacing="10">
                                                                                    <TextBox Classes="CompactInput" Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/rules" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                                                                    <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                                                                        <ComboBox.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                                            </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput MultiLineInput" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" MinHeight="72" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding IsText}" />
                                                                                    <Button Grid.Column="2" Classes="SecondaryActionButton" Tag="{Binding}" Click="OnRobotCustomCommandImagePathClick" Height="72" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding IsImage}">
                                                                                        <TextBlock Text="{Binding ImagePathButtonText}" TextTrimming="CharacterEllipsis" />
                                                                                    </Button>
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnRobotCustomCommandRemoveClick" Width="68" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                        <Button x:Name="RobotCustomCommandAddButton" Classes="SecondaryActionButton" Width="120" HorizontalAlignment="Left" Content="添加" Click="OnRobotCustomCommandAddClick" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionDiscordPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="DiscordSaveButton" Classes="ActionButton" Content="保存" Click="OnDiscordSaveClick" />
                                                <Button x:Name="DiscordToggleButton" Grid.Column="1" Classes="SecondaryActionButton" Content="启动" Click="OnDiscordToggleClick" />
                                                <Button x:Name="DiscordRedeployButton" Grid.Column="2" Classes="SecondaryActionButton" Content="重新部署命令" Click="OnDiscordRedeployClick" />
                                                <Button x:Name="DiscordClearButton" Grid.Column="3" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnDiscordClearClick" />
                                                <Button x:Name="DiscordRefreshButton" Grid.Column="4" Classes="SecondaryActionButton" Content="刷新" Click="OnDiscordRefreshClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="DiscordConfigTitleTextBlock" Classes="ConfigSectionTitle" Text="Discord 机器人配置" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide"><TextBlock x:Name="DiscordTokenLabelTextBlock" Classes="ConfigFieldLabel" Text="Bot Token" /><TextBox x:Name="DiscordTokenTextBox" Classes="CompactInput" PasswordChar="*" /></StackPanel>
                                                        <StackPanel Classes="ConfigFormField"><TextBlock x:Name="DiscordReconnectLabelTextBlock" Classes="ConfigFieldLabel" Text="重连间隔秒数" /><NumericUpDown x:Name="DiscordReconnectNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="120" /></StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide"><TextBlock x:Name="DiscordAdminUsersLabelTextBlock" Classes="ConfigFieldLabel" Text="管理员用户 ID" /><TextBox x:Name="DiscordAdminUsersTextBox" Classes="CompactInput" /></StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide"><TextBlock x:Name="DiscordAdminRolesLabelTextBlock" Classes="ConfigFieldLabel" Text="管理员角色 ID" /><TextBox x:Name="DiscordAdminRolesTextBox" Classes="CompactInput" /></StackPanel>
                                                    </WrapPanel>
                                                    <StackPanel Spacing="8">
                                                        <TextBlock x:Name="DiscordBindingTitleTextBlock" Classes="ConfigSectionTitle" Text="Profile / Guild / Channel 绑定" />
                                                        <TextBlock x:Name="DiscordBindingValidationTextBlock" Classes="ConfigHintText" Foreground="#C0392B" IsVisible="False" TextWrapping="Wrap" />
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="2*,1.3*,1.3*,Auto" ColumnSpacing="8">
                                                                    <TextBlock x:Name="DiscordBindingProfileHeaderTextBlock" Classes="TableHeaderText" Text="服务器档案" />
                                                                    <TextBlock x:Name="DiscordBindingGuildHeaderTextBlock" Grid.Column="1" Classes="TableHeaderText" Text="Guild ID" />
                                                                    <TextBlock x:Name="DiscordBindingChannelHeaderTextBlock" Grid.Column="2" Classes="TableHeaderText" Text="Channel ID" />
                                                                    <TextBlock x:Name="DiscordBindingActionHeaderTextBlock" Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="DiscordBindingsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="2*,1.3*,1.3*,Auto" ColumnSpacing="8">
                                                                                    <ComboBox Classes="CompactCombo" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                    <TextBox Grid.Column="1" Classes="CompactInput" Text="{Binding GuildId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding ChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnDiscordBindingRemoveClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                        <Button x:Name="DiscordBindingAddButton" Classes="SecondaryActionButton" Width="120" HorizontalAlignment="Left" Content="添加" Click="OnDiscordBindingAddClick" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                                        <TextBlock x:Name="DiscordCustomCommandsTitleTextBlock" Classes="ConfigSectionTitle" Text="自定义指令" />
                                                        <TextBlock x:Name="DiscordCustomCommandHintTextBlock" Classes="ConfigHintText" Text="指令名称仅允许 Discord 支持的 a-z、0-9、_、-；非法名称会提示并阻止保存。" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="DiscordCustomCommandValidationTextBlock" Classes="ConfigHintText" Foreground="#C0392B" IsVisible="False" TextWrapping="Wrap" />
                                                        <Grid RowDefinitions="Auto,*">
                                                            <Border Grid.Row="0" Classes="TableHeader">
                                                                <Grid ColumnDefinitions="150,140,*,68" ColumnSpacing="10">
                                                                    <TextBlock x:Name="DiscordCustomCommandNameHeaderTextBlock" Classes="TableHeaderText" Text="指令" />
                                                                    <TextBlock x:Name="DiscordCustomCommandTypeHeaderTextBlock" Grid.Column="1" Classes="TableHeaderText" Text="类型" />
                                                                    <TextBlock x:Name="DiscordCustomCommandContentHeaderTextBlock" Grid.Column="2" Classes="TableHeaderText" Text="内容" />
                                                                    <TextBlock x:Name="DiscordCustomCommandActionHeaderTextBlock" Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Grid.Row="1" Classes="TableBody">
                                                                <ItemsControl x:Name="DiscordCustomCommandsItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow" Padding="10,8">
                                                                                <Grid ColumnDefinitions="150,140,*,68" ColumnSpacing="10">
                                                                                    <TextBox Classes="CompactInput" Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/rules" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                                                                    <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                    <TextBox Grid.Column="2" Classes="CompactInput MultiLineInput" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="72" MinHeight="72" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding IsText}" />
                                                                                    <Button Grid.Column="2" Classes="SecondaryActionButton" Tag="{Binding}" Click="OnDiscordCustomCommandImagePathClick" Height="72" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding IsImage}"><TextBlock Text="{Binding ImagePathButtonText}" TextTrimming="CharacterEllipsis" /></Button>
                                                                                    <Button Grid.Column="3" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnDiscordCustomCommandRemoveClick" Width="68" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>
                                                        <Button x:Name="DiscordCustomCommandAddButton" Classes="SecondaryActionButton" Width="120" HorizontalAlignment="Left" Content="添加" Click="OnDiscordCustomCommandAddClick" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionGatewayPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="GatewaySaveButton" Classes="ActionButton" Content="保存" Click="OnGatewaySaveClick" />
                                                <Button x:Name="GatewayRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnGatewayRefreshClick" />
                                                <Button x:Name="GatewayToggleButton" Grid.Column="2" Classes="SecondaryActionButton" Content="启动" Click="OnGatewayToggleClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="GatewayConfigTitleTextBlock" Classes="ConfigSectionTitle" Text="TCP 网关" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="GatewayListenHostLabelTextBlock" Classes="ConfigFieldLabel" Text="监听地址" />
                                                            <TextBox x:Name="GatewayListenHostTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="GatewayListenPortLabelTextBlock" Classes="ConfigFieldLabel" Text="监听端口" />
                                                            <NumericUpDown x:Name="GatewayListenPortNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="65535" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="GatewayMaxConnectionsLabelTextBlock" Classes="ConfigFieldLabel" Text="最大连接数" />
                                                            <NumericUpDown x:Name="GatewayMaxConnectionsNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="100000" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="GatewayMaxConnectionsPerIpLabelTextBlock" Classes="ConfigFieldLabel" Text="单 IP 连接上限" />
                                                            <NumericUpDown x:Name="GatewayMaxConnectionsPerIpNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="10000" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="GatewayConnectTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="后端连接超时秒数" />
                                                            <NumericUpDown x:Name="GatewayConnectTimeoutNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="120" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="GatewayHealthCheckIntervalLabelTextBlock" Classes="ConfigFieldLabel" Text="健康检查间隔秒数" />
                                                            <NumericUpDown x:Name="GatewayHealthCheckIntervalNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="300" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="GatewayAllowListLabelTextBlock" Classes="ConfigFieldLabel" Text="IP 白名单" />
                                                            <TextBox x:Name="GatewayAllowListTextBox" Classes="CompactInput MultiLineInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="GatewayBlockListLabelTextBlock" Classes="ConfigFieldLabel" Text="IP 黑名单" />
                                                            <TextBox x:Name="GatewayBlockListTextBox" Classes="CompactInput MultiLineInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <TextBlock x:Name="GatewayIpRulesHintTextBlock" Classes="ConfigHintText" Text="每行一个 IP 或 CIDR 网段；黑名单优先。" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock x:Name="GatewayBackendsTitleTextBlock" Classes="ConfigSectionTitle" Text="后端服务器" />
                                                        <Button x:Name="GatewayAddBackendButton" Grid.Column="1" Classes="SecondaryActionButton" Content="添加" Click="OnGatewayAddBackendClick" />
                                                    </Grid>
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Classes="TableHeader">
                                                            <Grid ColumnDefinitions="112,112,128,96,58,90,132,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="后端名称" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="ServerId" />
                                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="主机" />
                                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="端口" />
                                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="权重" />
                                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="路由状态" />
                                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="本地实例" />
                                                                    <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Classes="TableBody">
                                                            <ItemsControl x:Name="GatewayBackendsItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="112,112,128,96,58,90,132,Auto" ColumnSpacing="8">
                                                                                <TextBox Classes="CompactInput" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                <TextBlock Grid.Column="1" Classes="TableSubCellText" Text="{Binding Id}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" VerticalAlignment="Center" />
                                                                                <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                <NumericUpDown Grid.Column="3" Classes="CompactNumber" Minimum="1" Maximum="65535" Value="{Binding Port, Mode=TwoWay}" />
                                                                                <NumericUpDown Grid.Column="4" Classes="CompactNumber" Minimum="0" Maximum="100" Value="{Binding Weight, Mode=TwoWay}" />
                                                                                <ComboBox Grid.Column="5" Classes="CompactCombo" ItemsSource="{Binding RoutingStateOptions}" SelectedItem="{Binding RoutingState, Mode=TwoWay}">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding Converter={StaticResource GatewayRoutingStateDisplayConverter}}" />
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <ComboBox Grid.Column="6" Classes="CompactCombo" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                                                                                        <ComboBox.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                            </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                    <Button Grid.Column="7" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="删除" Click="OnGatewayRemoveBackendClick" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                                        <TextBlock x:Name="GatewayRuntimeTitleTextBlock" Classes="ConfigSectionTitle" Text="路由与重定向" />
                                                        <Button x:Name="GatewayDeployRedirectModButton" Grid.Column="1" Classes="SecondaryActionButton" Content="部署重定向模组" Click="OnGatewayDeployRedirectModClick" />
                                                        <Button x:Name="GatewayRoutingHistoryButton" Grid.Column="2" Classes="SecondaryActionButton" Content="历史" Click="OnGatewayShowRoutingHistoryClick" />
                                                    </Grid>
                                                    <TextBlock x:Name="GatewayRuntimeSummaryTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="14">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="活跃连接" />
                                                            <TextBlock x:Name="GatewayActiveConnectionsTextBlock" Classes="TableCellText" Text="0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="已接收" />
                                                            <TextBlock x:Name="GatewayAcceptedConnectionsTextBlock" Classes="TableCellText" Text="0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="已拒绝" />
                                                            <TextBlock x:Name="GatewayRejectedConnectionsTextBlock" Classes="TableCellText" Text="0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="失败" />
                                                            <TextBlock x:Name="GatewayFailedConnectionsTextBlock" Classes="TableCellText" Text="0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="上行" />
                                                            <TextBlock x:Name="GatewayUpstreamTextBlock" Classes="TableCellText" Text="0 B" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="5" Spacing="2">
                                                            <TextBlock Classes="ConfigFieldLabel" Text="下行" />
                                                            <TextBlock x:Name="GatewayDownstreamTextBlock" Classes="TableCellText" Text="0 B" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid RowDefinitions="Auto,*">
                                                        <Border Grid.Row="0" Classes="TableHeader">
                                                            <Grid ColumnDefinitions="220,90,74,55,120,176" ColumnSpacing="8">
                                                                <TextBlock Classes="TableHeaderText" Text="后端名称/主机/ServerId" />
                                                                <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="状态" />
                                                                <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="活跃连接" />
                                                                <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="权重" />
                                                                <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="实时 / 峰值流量" />
                                                                <TextBlock x:Name="GatewayBackendStatisticsHeaderTextBlock" Grid.Column="5" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Classes="TableBody">
                                                            <ItemsControl x:Name="GatewayBackendRuntimeItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="220,90,74,55,120,176" ColumnSpacing="8">
                                                                                <StackPanel Spacing="1">
                                                                                    <TextBlock Classes="TableCellText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                                                    <TextBlock Classes="TableSubCellText" Text="{Binding Address}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}" />
                                                                                    <TextBlock Classes="TableSubCellText" Text="{Binding BackendId}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BackendId}" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding StatusText}" />
                                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding ActiveConnectionsText}" />
                                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding WeightText}" />
                                                                                <TextBlock Grid.Column="4" Classes="TableSubCellText" Text="{Binding TrafficText}" TextWrapping="Wrap" />
                                                                                <WrapPanel Grid.Column="5" Orientation="Horizontal" ItemHeight="28" ItemWidth="76">
                                                                                    <Button Classes="InlineActionButton" Tag="{Binding}" Content="统计" Click="OnGatewayShowStatisticsClick" />
                                                                                    <Button Classes="InlineActionButton" Tag="{Binding}" Content="重定向" Click="OnGatewayRedirectPlayerClick" />
                                                                                    <Button Classes="InlineActionButton" Tag="{Binding}" Content="维护" Click="OnGatewayEnterMaintenanceClick" />
                                                                                    <Button Classes="InlineActionButton" Tag="{Binding}" Content="疏散" Click="OnGatewayEvacuateClick" />
                                                                                </WrapPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionAuthPanel" Margin="0,-8,0,0" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <ComboBox x:Name="AuthProfileComboBox" IsVisible="False" Classes="CompactCombo" SelectionChanged="OnAuthProfileSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="AuthClearButton" Classes="SecondaryActionButton DangerButton" Content="清空" Click="OnAuthClearClick" />
                                                <Button x:Name="AuthBackButton" Grid.Column="1" Classes="SecondaryActionButton" Content="返回" Click="OnAuthBackClick" IsVisible="False" />
                                                <Button x:Name="AuthSaveButton" Grid.Column="2" Classes="ActionButton" Content="保存" Click="OnAuthSaveClick" IsVisible="False" />
                                                <Button x:Name="AuthRefreshButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnAuthRefreshClick" />
                                                <Button x:Name="AuthDeployButton" Grid.Column="4" Classes="SecondaryActionButton" Content="部署认证模组" Click="OnAuthDeployClick" IsVisible="False" />
                                            </Grid>
                                            <TextBlock x:Name="AuthStatusTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid x:Name="AuthListPanel" RowDefinitions="Auto,*">
                                                    <Border Grid.Row="0" Classes="TableHeader">
                                                        <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="服务器名称" />
                                                            <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="配置路径" />
                                                            <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="修改时间" />
                                                            <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="1" Classes="TableBody">
                                                        <ItemsControl x:Name="AuthConfigItemsControl">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Classes="TableRow">
                                                                        <Grid ColumnDefinitions="44,1.2*,2.4*,1*,Auto" ColumnSpacing="8">
                                                                            <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                            <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                                            <Button Grid.Column="2" Classes="DownloadTextButton TablePathButton" Tag="{Binding ConfigPath}" HorizontalAlignment="Stretch" Click="OnOpenConfigFileClick">
                                                                                <TextBlock Classes="TableCellText TablePathText" Text="{Binding ConfigPath}" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                            </Button>
                                                                            <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding ModifiedText}" />
                                                                            <Button Grid.Column="4" Classes="SecondaryActionButton" Tag="{Binding}" Content="修改" Click="OnAuthEditConfigClick" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Grid>
                                                <StackPanel x:Name="AuthEditorPanel" Spacing="10" IsVisible="False">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="AuthEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用认证" />
                                                            <ToggleSwitch x:Name="AuthEnabledCheckBox" Classes="LabelledToggle" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="AuthLoginTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="登录超时秒数" />
                                                            <NumericUpDown x:Name="AuthLoginTimeoutNumericUpDown" Classes="CompactNumber" Minimum="10" Maximum="600" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="AuthRememberSessionLabelTextBlock" Classes="ConfigFieldLabel" Text="会话记住分钟" />
                                                            <NumericUpDown x:Name="AuthRememberSessionNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="1440" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="AuthDiscourseEnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用 Discourse 登录" />
                                                            <ToggleSwitch x:Name="AuthDiscourseEnabledCheckBox" Classes="LabelledToggle" Click="OnAuthDiscourseModeClick" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseBaseUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="Discourse 地址" />
                                                            <TextBox x:Name="AuthDiscourseBaseUrlTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseSecretLabelTextBlock" Classes="ConfigFieldLabel" Text="共享密钥" />
                                                            <TextBox x:Name="AuthDiscourseSecretTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscoursePublicCallbackLabelTextBlock" Classes="ConfigFieldLabel" Text="公开回调地址" />
                                                            <TextBox x:Name="AuthDiscoursePublicCallbackTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseListenPrefixLabelTextBlock" Classes="ConfigFieldLabel" Text="本地监听地址" />
                                                            <TextBox x:Name="AuthDiscourseListenPrefixTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ToggleField">
                                                            <TextBlock x:Name="AuthOAuth2EnabledLabelTextBlock" Classes="ConfigFieldLabel" Text="启用 OAuth2/OIDC 登录" />
                                                            <ToggleSwitch x:Name="AuthOAuth2EnabledCheckBox" Classes="LabelledToggle" Click="OnAuthOAuth2ModeClick" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2DiscoveryUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="Discovery 地址（可选）" />
                                                            <TextBox x:Name="AuthOAuth2DiscoveryUrlTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2AuthorizationEndpointLabelTextBlock" Classes="ConfigFieldLabel" Text="授权端点" />
                                                            <TextBox x:Name="AuthOAuth2AuthorizationEndpointTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2TokenEndpointLabelTextBlock" Classes="ConfigFieldLabel" Text="Token 端点" />
                                                            <TextBox x:Name="AuthOAuth2TokenEndpointTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2UserInfoEndpointLabelTextBlock" Classes="ConfigFieldLabel" Text="UserInfo 端点" />
                                                            <TextBox x:Name="AuthOAuth2UserInfoEndpointTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2ClientIdLabelTextBlock" Classes="ConfigFieldLabel" Text="Client ID" />
                                                            <TextBox x:Name="AuthOAuth2ClientIdTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2ClientSecretLabelTextBlock" Classes="ConfigFieldLabel" Text="Client Secret" />
                                                            <TextBox x:Name="AuthOAuth2ClientSecretTextBox" Classes="CompactInput" PasswordChar="*" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2ScopeLabelTextBlock" Classes="ConfigFieldLabel" Text="Scope" />
                                                            <TextBox x:Name="AuthOAuth2ScopeTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2PublicCallbackLabelTextBlock" Classes="ConfigFieldLabel" Text="公开回调地址" />
                                                            <TextBox x:Name="AuthOAuth2PublicCallbackTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2ListenPrefixLabelTextBlock" Classes="ConfigFieldLabel" Text="本地监听地址" />
                                                            <TextBox x:Name="AuthOAuth2ListenPrefixTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2UserIdClaimLabelTextBlock" Classes="ConfigFieldLabel" Text="用户 ID claim" />
                                                            <TextBox x:Name="AuthOAuth2UserIdClaimTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2UsernameClaimLabelTextBlock" Classes="ConfigFieldLabel" Text="用户名 claim" />
                                                            <TextBox x:Name="AuthOAuth2UsernameClaimTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2DisplayNameClaimLabelTextBlock" Classes="ConfigFieldLabel" Text="显示名 claim" />
                                                            <TextBox x:Name="AuthOAuth2DisplayNameClaimTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthOAuth2EmailClaimLabelTextBlock" Classes="ConfigFieldLabel" Text="邮箱 claim" />
                                                            <TextBox x:Name="AuthOAuth2EmailClaimTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                    <Grid ColumnDefinitions="Auto,Auto,260,*" ColumnSpacing="8">
                                                        <TextBlock x:Name="AuthPlayersTitleTextBlock" Classes="ConfigSectionTitle" Text="玩家认证数据" />
                                                        <Button x:Name="AuthRefreshPlayersButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新玩家" Click="OnAuthRefreshPlayersClick" />
                                                        <TextBox x:Name="AuthPlayerSearchTextBox" Grid.Column="2" Classes="CompactInput" PlaceholderText="搜索玩家名、UID 或外部账号" TextChanged="OnAuthPlayerSearchTextChanged" />
                                                    </Grid>
                                                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
                                                        <Border Grid.Row="0" Classes="TableHeader">
                                                            <Grid ColumnDefinitions="1.5*,1.4*,1.4*,1*,1.2*,Auto" ColumnSpacing="8">
                                                                <TextBlock Classes="TableHeaderText" Text="玩家" />
                                                                <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="注册" />
                                                                <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="最后登录" />
                                                                <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="密码" />
                                                                <TextBlock x:Name="AuthExternalAccountHeaderTextBlock" Grid.Column="4" Classes="TableHeaderText" Text="外部账号" />
                                                                <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Classes="TableBody">
                                                            <ListBox x:Name="AuthPlayersListBox" Classes="FlatList TableList" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnDefinitions="1.5*,1.4*,1.4*,1*,1.2*,Auto" ColumnSpacing="8" MinHeight="38">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Classes="TableCellText" Text="{Binding PlayerName}" FontWeight="SemiBold" />
                                                                                <TextBlock Classes="TableSubCellText" Text="{Binding PlayerUid}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                                <TextBlock Classes="TableCellText" Text="{Binding RegisteredAtText}" />
                                                                                <TextBlock Classes="TableSubCellText" Text="{Binding RegisteredIp}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                                <TextBlock Classes="TableCellText" Text="{Binding LastLoginAtText}" />
                                                                                <TextBlock Classes="TableSubCellText" Text="{Binding LastIp}" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding PasswordStateText}" />
                                                                            <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding ExternalUsername}" />
                                                                            <Button Grid.Column="5" Classes="SecondaryActionButton DangerButton" Tag="{Binding}" Content="清空密码" Click="OnAuthClearPlayerPasswordClick" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                            <Border Grid.Row="1" Height="0" MinHeight="0" MaxHeight="0" IsVisible="False" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="{DynamicResource SplitLineBrush}" BorderThickness="0,1,0,0">
                                <Grid Margin="18,0,18,0" ColumnDefinitions="*,250,Auto" ColumnSpacing="10" ClipToBounds="True">
                                    <ScrollViewer Grid.Column="0" MinWidth="0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                                        <ItemsControl x:Name="LaunchTargetsItemsControl" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Classes="TextTabButton" MaxWidth="180" Content="{Binding DisplayName}" Tag="{Binding}" Click="OnLaunchTargetChipClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid Grid.Column="1" ColumnDefinitions="*,34,34" ColumnSpacing="6" VerticalAlignment="Center" MinWidth="234" MaxWidth="250">
                                        <ComboBox x:Name="LaunchAddProfileComboBox" Grid.Column="0" Classes="CompactCombo" MinWidth="150" PlaceholderText="添加服务器">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="LaunchAddProfileButton" Grid.Column="1" Classes="SecondaryActionButton LaunchIconButton" Content="+" Click="OnLaunchAddProfileClick" />
                                        <Button x:Name="LaunchRemoveProfileButton" Grid.Column="2" Classes="SecondaryActionButton DangerButton LaunchIconButton" Content="-" Click="OnLaunchRemoveSelectedProfileClick" />
                                    </Grid>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="154">
                                        <Button
                                            x:Name="LaunchServerButton"
                                            Click="OnLaunchServerClick"
                                            PointerEntered="OnLaunchServerPointerEntered"
                                            PointerExited="OnLaunchServerPointerExited">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7" VerticalAlignment="Center">
                                                <Path
                                                    x:Name="LaunchActionIconPath"
                                                    Width="13"
                                                    Height="13"
                                                    Stretch="Uniform"
                                                    Fill="#FFFFFF"
                                                    Data="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z" />
                                                <TextBlock
                                                    x:Name="LaunchActionTextBlock"
                                                    Grid.Column="1"
                                                    Text="启动服务器"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource LaunchButtonTextBrush}" />
                                                <Border
                                                    x:Name="LaunchSelectionPillHost"
                                                    Grid.Column="2"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        Height="24"
                                                        MinWidth="122"
                                                        MaxWidth="168"
                                                        Padding="8,0"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource LaunchSelectionPillBrush}"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            x:Name="LaunchSelectionSummaryTextBlock"
                                                            Text="未选择档案 | 未固定存档"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch"
                                                            TextAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource LaunchSelectionPillTextBrush}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Border>
        <Border
            x:Name="ToastHost"
            Classes="ToastSurface"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,42,14,0"
            MinWidth="180"
            MaxWidth="320"
            IsVisible="False"
            PointerEntered="OnToastPointerEntered"
            PointerExited="OnToastPointerExited">
            <Grid ColumnDefinitions="4,*,Auto">
                <Border
                    x:Name="ToastAccentBorder"
                    Grid.Column="0"
                    Background="#555555"
                    CornerRadius="4,0,0,4" />
                <TextBlock
                    x:Name="ToastMessageTextBlock"
                    Grid.Column="1"
                    Margin="8,6,4,6"
                    Foreground="{DynamicResource ToastTextBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="ToastCloseButton"
                    Grid.Column="2"
                    Classes="ToastCloseButton"
                    Margin="0,4,6,4"
                    Click="OnToastCloseClick">
                    <Viewbox Width="10" Height="10">
                        <Path
                            Stroke="{DynamicResource ToastCloseBrush}"
                            StrokeThickness="1.4"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            Data="M18 6L6 18M6 6L18 18" />
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
