<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LauncherGo.Services\LauncherGo.Services.csproj" />
    <ProjectReference Include="..\LauncherGo.Ui\LauncherGo.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test the actual map scheduling/query helpers without redistributing game assemblies. -->
    <Compile Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\src\Util\LruCache.cs" Link="ServerMap\LruCache.cs" />
    <Compile Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\src\Util\ResettableCache.cs" Link="ServerMap\ResettableCache.cs" />
    <Compile Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\src\Util\BackgroundMapWork.cs" Link="ServerMap\BackgroundMapWork.cs" />
    <Compile Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\src\World\SavedWorldQueries.cs" Link="ServerMap\SavedWorldQueries.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Link="LicenseFixtures\LauncherGo.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\LICENSE.txt" Link="LicenseFixtures\MapMod.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LauncherGo.ServerMapHost\WebRoot\LICENSE.txt" Link="LicenseFixtures\MapWeb.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LauncherGo.Services\EmbeddedMods\ServerMapMod\VS-LiveMap-Revival-LICENSE.txt" Link="LicenseFixtures\LiveMapMod.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LauncherGo.ServerMapHost\WebRoot\vendor\VS-LiveMap-Revival-LICENSE.txt" Link="LicenseFixtures\LiveMapWeb.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LauncherGo.ServerMapHost\WebRoot\assets\icons\spawn.png" Link="LicenseFixtures\spawn.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
